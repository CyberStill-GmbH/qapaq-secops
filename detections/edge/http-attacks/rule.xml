<!--
  QAPAQ SecOps · detección como código · detections/edge/http-attacks (metadata.yaml).
  Ataques web contra la propia consola del SOC, desde la bitácora JSON del edge nginx
  (infra/wazuh/network/edge/qapaq-edge-logging.conf → volumen de logs del manager → <localfile> json).
  srcip es la IP real del cliente (edge confía en X-Forwarded-For solo desde la VPC del ALB).
  Los patrones cubren la forma literal y la codificada en URL (%27, %3C, %2e%2e...). Orden de hermanos =
  prioridad: ataque > sondeo > estado HTTP. Rango 101830-101841.
  101838/101839 son nivel 1 (no 0): analysisd evalúa primero las hijas de nivel 0 y entonces el 4xx/5xx
  taparía a las reglas de ataque; además las reglas de frecuencia necesitan historial del padre.
  Se instala como qapaq_soc_edge_http_attacks.xml (carga antes que soc_authentication, que depende de 101830).
-->
<group name="web,accesslog,qapaq_edge,qapaq_network,">

  <rule id="101830" level="0">
    <decoded_as>json</decoded_as>
    <field name="qapaq.vendor">^qapaq-edge$</field>
    <description>QAPAQ Edge: $(method) $(url) → $(http_status) desde $(srcip).</description>
    <options>no_full_log</options>
  </rule>

  <rule id="101831" level="8">
    <if_sid>101830</if_sid>
    <url type="pcre2">(?i)(union(\s|%20|\+|/\*.*?\*/)+(all(\s|%20|\+)+)?select|select(\s|%20|\+).+(\s|%20|\+)from(\s|%20|\+)|information_schema|(%27|')(\s|%20|\+)*(or|and)(\s|%20|\+)+[\w%'"]+(\s|%20|\+)*(=|%3d|like)|\b(sleep|benchmark|pg_sleep)(\s|%20)*(\(|%28)\d|waitfor(\s|%20|\+)+delay|;(\s|%20)*(drop|shutdown)(\s|%20|\+)|xp_cmdshell)</url>
    <description>QAPAQ Edge: intento de inyección SQL contra la consola del SOC desde $(srcip): $(url).</description>
    <options>no_full_log</options>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>qapaq_edge_attack,attack,sql_injection,</group>
  </rule>

  <rule id="101832" level="8">
    <if_sid>101830</if_sid>
    <url type="pcre2">(?i)((\x3c|%3c)(\s|%20)*/?(script|svg|img|iframe|body|details)\b|javascript(:|%3a)|\bon(error|load|mouseover|focus|toggle)(\s|%20)*(=|%3d)|(alert|prompt|confirm)(\s|%20)*(\(|%28)|document\.(cookie|domain))</url>
    <description>QAPAQ Edge: intento de XSS contra la consola del SOC desde $(srcip): $(url).</description>
    <options>no_full_log</options>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>qapaq_edge_attack,attack,</group>
  </rule>

  <rule id="101833" level="8">
    <if_sid>101830</if_sid>
    <url type="pcre2">(?i)(\.\./|\.\.%2f|\.\.%5c|%2e%2e(/|%2f|%5c|%252f)|%252e%252e|\.\.\\|/etc/(passwd|shadow|hosts)|win\.ini|boot\.ini|/proc/self/(environ|cmdline)|c:(\\|%5c)windows)</url>
    <description>QAPAQ Edge: path traversal / lectura de archivos locales contra la consola del SOC desde $(srcip): $(url).</description>
    <options>no_full_log</options>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>qapaq_edge_attack,attack,</group>
  </rule>

  <rule id="101834" level="10">
    <if_sid>101830</if_sid>
    <url type="pcre2">(?i)(\$\{jndi:|%24%7bjndi|\$%7bjndi|(;|%3b|\||%7c|`|%60|\$\(|%24%28)(\s|%20|\+)*(id|whoami|uname|cat(\s|%20|\+)|wget|curl|nc(\s|%20|\+)|bash|sh(\s|%20|\+)|python|perl)\b|/bin/(ba)?sh|cmd\.exe|powershell(\.exe)?(\s|%20|\+)|\(\)(\s|%20)*\{(\s|%20)*:;)</url>
    <description>QAPAQ Edge: intento de ejecución remota de comandos (RCE/inyección/Log4Shell) desde $(srcip): $(url).</description>
    <options>no_full_log</options>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>qapaq_edge_attack,attack,</group>
  </rule>

  <rule id="101835" level="6">
    <if_sid>101830</if_sid>
    <field name="user_agent" type="pcre2">(?i)(sqlmap|nikto|nmap|masscan|zgrab|nuclei|wpscan|gobuster|dirbuster|\bdirb\b|ffuf|feroxbuster|acunetix|nessus|openvas|wfuzz|hydra|whatweb|httpx|l9explore|l9tcpid|fuzz faster|jaeles|xray|arachni|w3af|commix|joomscan|zaproxy|burpcollaborator)</field>
    <description>QAPAQ Edge: escáner de vulnerabilidades ($(user_agent)) contra la consola del SOC desde $(srcip).</description>
    <options>no_full_log</options>
    <mitre>
      <id>T1595.002</id>
    </mitre>
    <group>qapaq_edge_attack,recon,</group>
  </rule>

  <rule id="101836" level="5">
    <if_sid>101830</if_sid>
    <url type="pcre2">(?i)^/+(\.env|\.git/|\.svn/|\.aws/|\.ssh/|\.ds_store|\.htaccess|\.htpasswd|wp-(login|admin|content|includes|config)|xmlrpc\.php|phpmyadmin|pma/|myadmin|adminer|admin\.php|config\.(php|json|ya?ml)|actuator|server-status|vendor/phpunit|hnap1|boaform|cgi-bin/|owa/|ecp/|autodiscover/|solr/|druid/|telescope|_ignition|console/|manager/html|jmx-console|\.vscode/|backup|dump\.sql|.*\.(php[0-9]?|asp|aspx|jsp|cgi|bak|sql)(\?|$))</url>
    <description>QAPAQ Edge: sondeo de rutas sensibles o de tecnologías ajenas a la consola del SOC desde $(srcip): $(url) → $(http_status).</description>
    <options>no_full_log</options>
    <mitre>
      <id>T1595.003</id>
    </mitre>
    <group>qapaq_edge_attack,recon,</group>
  </rule>

  <rule id="101837" level="10" frequency="10" timeframe="300">
    <if_matched_group>qapaq_edge_attack</if_matched_group>
    <same_source_ip />
    <description>QAPAQ Edge: campaña de ataque/escaneo contra la consola del SOC: 10+ peticiones maliciosas desde $(srcip) en 5 min.</description>
    <options>no_full_log</options>
    <mitre>
      <id>T1595</id>
      <id>T1190</id>
    </mitre>
    <group>qapaq_edge_campaign,attack,</group>
  </rule>

  <rule id="101838" level="1">
    <if_sid>101830</if_sid>
    <field name="http_status">^4\d\d$</field>
    <description>QAPAQ Edge: respuesta $(http_status) a $(srcip) para $(url).</description>
    <options>no_full_log</options>
    <group>qapaq_edge_4xx,</group>
  </rule>

  <rule id="101839" level="1">
    <if_sid>101830</if_sid>
    <field name="http_status">^5\d\d$</field>
    <description>QAPAQ Edge: error $(http_status) del backend para $(url).</description>
    <options>no_full_log</options>
    <group>qapaq_edge_5xx,</group>
  </rule>

  <rule id="101840" level="7" frequency="40" timeframe="120">
    <if_matched_sid>101838</if_matched_sid>
    <same_source_ip />
    <description>QAPAQ Edge: pico de respuestas 4xx para $(srcip): 40+ en 2 min (enumeración o cliente roto).</description>
    <options>no_full_log</options>
    <mitre>
      <id>T1595.003</id>
    </mitre>
    <group>qapaq_edge_spike,</group>
  </rule>

  <rule id="101841" level="9" frequency="30" timeframe="120" ignore="600">
    <if_matched_sid>101839</if_matched_sid>
    <description>QAPAQ Edge: pico de errores 5xx en la consola del SOC: 30+ en 2 min (caída de un backend o denegación de servicio).</description>
    <options>no_full_log</options>
    <mitre>
      <id>T1499</id>
    </mitre>
    <group>qapaq_edge_spike,service_availability,</group>
  </rule>

</group>
