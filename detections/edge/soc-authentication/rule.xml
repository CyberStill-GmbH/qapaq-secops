<!--
  QAPAQ SecOps · detección como código · detections/edge/soc-authentication (metadata.yaml).
  Inicios de sesión con contraseña en la consola del SOC vistos en el edge (POST /api/auth/password).
  El API responde 303 siempre; el edge clasifica con la cabecera Location (authError= = fallo) y lo deja en
  auth_result. No hay usuario en la bitácora (el cuerpo no se registra): la correlación es por IP; el
  usuario está en la auditoría del API. La geolocalización la agrega el pipeline del indexer (GeoLocation.*).
  Depende de 101830 (http-attacks). Se instala como qapaq_soc_edge_soc_authentication.xml.
-->
<group name="web,qapaq_edge,qapaq_network,">

  <rule id="101842" level="5">
    <if_sid>101830</if_sid>
    <field name="auth_result">^failure$</field>
    <description>QAPAQ Edge: inicio de sesión fallido en la consola del SOC desde $(srcip).</description>
    <options>no_full_log</options>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>qapaq_edge_auth_failure,</group>
  </rule>

  <rule id="101843" level="3">
    <if_sid>101830</if_sid>
    <field name="auth_result">^success$</field>
    <description>QAPAQ Edge: inicio de sesión exitoso en la consola del SOC desde $(srcip).</description>
    <options>no_full_log</options>
    <group>authentication_success,qapaq_edge_auth_success,</group>
  </rule>

  <rule id="101844" level="10" frequency="6" timeframe="300">
    <if_matched_sid>101842</if_matched_sid>
    <same_source_ip />
    <description>QAPAQ Edge: fuerza bruta contra el login de la consola del SOC: 6+ fallos desde $(srcip) en 5 min.</description>
    <options>no_full_log</options>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>qapaq_edge_auth_failure,qapaq_attack,</group>
  </rule>

  <rule id="101845" level="13" timeframe="1800">
    <if_sid>101843</if_sid>
    <if_matched_sid>101844</if_matched_sid>
    <same_source_ip />
    <description>QAPAQ Edge: inicio de sesión exitoso en la consola del SOC desde $(srcip) tras fuerza bruta desde la misma IP.</description>
    <options>no_full_log</options>
    <mitre>
      <id>T1110.001</id>
      <id>T1078</id>
    </mitre>
    <group>qapaq_attack_chain,qapaq_attack,</group>
  </rule>

  <rule id="101846" level="9" frequency="20" timeframe="600" ignore="900">
    <if_matched_sid>101842</if_matched_sid>
    <different_srcip />
    <description>QAPAQ Edge: 20+ inicios de sesión fallidos en la consola del SOC desde IPs distintas en 10 min (password spraying distribuido).</description>
    <options>no_full_log</options>
    <mitre>
      <id>T1110.003</id>
    </mitre>
    <group>qapaq_edge_auth_failure,qapaq_attack,</group>
  </rule>

</group>
