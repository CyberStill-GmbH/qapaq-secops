<!--
  QAPAQ SOC · detección como código · detections/linux/ssh-session-tracking (metadata.yaml).
  Seguimiento de sesiones SSH por cuenta. Complementa (no repite) a 101750 (éxito tras fuerza bruta) y a
  101761-101763 (SSH desde IP no administrativa, noise-tuning). La IP y la geolocalización de cada sesión
  las ponen 5715 y el pipeline del indexer (GeoLocation.*); las listas de reputación están en
  detections/network/threat-intel y la correlación con Cloudflare/edge en detections/network/cross-source-correlation.
  El archivo carga después de qapaq_soc_linux_noise_tuning.xml y qapaq_soc_linux_ssh_bruteforce_success.xml:
  sus reglas hijas de 5715 tienen prioridad.
  Se instala como qapaq_soc_linux_ssh_session_tracking.xml.
-->
<group name="syslog,sshd,qapaq_network,qapaq_linux,">

  <rule id="101820" level="10" frequency="3" timeframe="3600">
    <if_matched_sid>101761</if_matched_sid>
    <same_user />
    <different_srcip />
    <description>QAPAQ Linux: la cuenta $(dstuser) inició sesión SSH desde 3 o más IPs no administrativas distintas en 1 h (última: $(srcip)).</description>
    <mitre>
      <id>T1078.003</id>
      <id>T1021.004</id>
    </mitre>
    <group>qapaq_ssh_session,</group>
  </rule>

  <rule id="101821" level="12">
    <if_sid>5715</if_sid>
    <user>^root$</user>
    <description>QAPAQ Linux: inicio de sesión SSH directo como root desde $(srcip) (la política QAPAQ exige cuenta nominal + sudo).</description>
    <mitre>
      <id>T1078.003</id>
      <id>T1021.004</id>
    </mitre>
    <group>qapaq_ssh_session,</group>
  </rule>

</group>
