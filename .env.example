QAPAQ_PROFILE=development
QAPAQ_API_HOST=127.0.0.1
QAPAQ_API_PORT=3000

POSTGRES_USER=qapaq
POSTGRES_PASSWORD=qapaq_local_only
POSTGRES_DB=qapaq_secops

QAPAQ_POSTGRES_HOST=127.0.0.1
QAPAQ_POSTGRES_PORT=5432
QAPAQ_POSTGRES_DATABASE=qapaq_secops
QAPAQ_POSTGRES_USERNAME=qapaq
QAPAQ_POSTGRES_PASSWORD_REF=secret://environment/POSTGRES_PASSWORD

QAPAQ_REDIS_HOST=127.0.0.1
QAPAQ_REDIS_PORT=6379

MINIO_ROOT_USER=qapaq_local
MINIO_ROOT_PASSWORD=change_this_local_password
QAPAQ_MINIO_ENDPOINT=127.0.0.1
QAPAQ_MINIO_PORT=9000
QAPAQ_MINIO_RAW_BUCKET=qapaq-raw-local
QAPAQ_MINIO_ACCESS_KEY_REF=secret://environment/MINIO_ROOT_USER
QAPAQ_MINIO_SECRET_KEY_REF=secret://environment/MINIO_ROOT_PASSWORD

QAPAQ_WAZUH_GATEWAY_BASE_URL=http://127.0.0.1:18080
QAPAQ_WAZUH_GATEWAY_ACCESS_TOKEN_REF=secret://environment/WAZUH_GATEWAY_ACCESS_TOKEN
QAPAQ_WAZUH_DATASET=wazuh-alerts
QAPAQ_WAZUH_CURSOR_SECRET_REF=secret://environment/WAZUH_CURSOR_HMAC
QAPAQ_WAZUH_CURSOR_TTL=1m
QAPAQ_WAZUH_MAX_RESPONSE_BYTES=10485760

# C-24: select QAPAQ_SECRET_PROVIDER_TYPE only after approving a real adapter.
# The production backend/identity/endpoint remain TO_BE_PROVIDED in source-inventory.yaml.
QAPAQ_SECRET_PROVIDER_TIMEOUT=5s
QAPAQ_SECRET_FINGERPRINT_KEY_REF=secret://environment/QAPAQ_SECRET_FINGERPRINT_KEY
