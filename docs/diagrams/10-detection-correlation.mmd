flowchart LR
    EVENT["Normalized Event"]
    CTX["Threat Intelligence y contexto versionado"]
    ENR["Enriched Event"]
    ENGINE["Deteccion y correlacion"]
    RESULT["Detection - resultado validado"]
    CAND["Alert Candidate"]
    QUALIFY["Enrichment y deduplicacion"]
    ALERT["Alert"]
    SOC["Incident or Case"]
    RESPONSE["Response - SOAR autorizado"]
    CLOSE["Resolution y Closure"]
    EVENT --> ENR
    CTX --> ENR
    ENR --> ENGINE --> RESULT --> CAND --> QUALIFY
    QUALIFY -->|si corresponde| ALERT
    ALERT -->|si requiere investigacion| SOC
    SOC --> RESPONSE --> CLOSE
