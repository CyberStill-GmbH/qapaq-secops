C4Container
    title C4 Nivel 2 — Contenedores conceptuales de QAPAQ SecOps

    Person(user, "Usuario autorizado", "SOC, auditoría, antifraude o administración")
    System_Ext(edge, "Balanceador de acceso", "Health checks y distribución a réplicas QAPAQ")
    System_Ext(krakendLb, "Balanceador interno de integraciones", "Distribuye tráfico entre nodos KrakenD")
    System_Ext(krakend, "Pool KrakenD", "Gateway stateless para proveedores y webhooks autorizados")
    System_Ext(entra, "Microsoft Entra ID", "IdP humano")
    System_Ext(m365, "Microsoft 365", "Única fuente empresarial del MVP")
    System_Ext(wazuh, "Wazuh", "Office 365 collector, ruleset, alertas e Indexer")
    System_Ext(shuffle, "Shuffle", "Editor y motor no-code post-MVP")
    System_Ext(secrets, "SecretProvider", "Resuelve referencias bajo identidad técnica")
    System_Ext(teams, "Microsoft Teams Workflow", "Publica en el canal SOC dedicado")

    System_Boundary(qapaq, "QAPAQ SecOps — monolito modular") {
        Container(web, "Consola QAPAQ", "React + TypeScript", "Alertas y lazy-loaded workspaces SOC/Ayni")
        Container(api, "Qapaq SecOps Core · API/BFF", "NestJS + Fastify", "Identidad, políticas, dominio SOC, Ayni, auditoría y control SOAR")
        Container(worker, "Workers y pollers", "NestJS + BullMQ", "Admisión, normalización, detección, indexación y jobs recuperables")
        ContainerDb(pg, "Operational Store", "PostgreSQL", "Estado, políticas, checkpoints, auditoría y outbox/inbox")
        ContainerDb(queue, "Job Queue", "Redis + BullMQ", "Jobs pequeños, prioridades y desacople de carga")
        ContainerDb(search, "QAPAQ Telemetry Search", "OpenSearch", "Índice HOT/WARM para búsqueda; proyecciones versionadas")
        ContainerDb(objects, "Object Storage", "Azure Blob / S3-compatible", "Raw/manifiestos y archivo COLD bajo retención aprobada")
    }

    Rel_D(user, edge, "Usa", "HTTPS")
    Rel_D(edge, web, "Distribuye a réplica sana", "HTTPS")
    Rel_D(edge, api, "Distribuye a réplica sana", "HTTPS")
    Rel_R(web, api, "Invoca", "HTTPS/JSON")
    Rel_U(api, entra, "", "OIDC")
    Rel_D(api, pg, "Gestiona estado")
    Rel_D(api, queue, "Encola trabajos")
    Rel_D(worker, queue, "Consume trabajos")
    Rel_D(worker, pg, "Persiste progreso")
    Rel_D(worker, search, "Indexa telemetría")
    Rel_D(worker, objects, "Preserva raw y evidencia")
    Rel_D(m365, wazuh, "")
    Rel_U(worker, krakendLb, "Consulta proveedores e Indexer", "HTTPS")
    Rel_D(krakendLb, krakend, "Balancea nodos sanos", "HTTPS")
    Rel_D(krakend, wazuh, "API permitida", "HTTPS read-only")
    Rel_D(worker, shuffle, "Inicia playbook y reconcilia", "Webhook de servicio")
    Rel_U(worker, secrets, "")
    Rel_L(worker, teams, "", "HTTPS")
