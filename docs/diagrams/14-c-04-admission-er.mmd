erDiagram
    SOURCES {
        uuid id PK
        text tenant_id
        text provider
        text product
        text dataset
        text instance_key
        text status
    }
    SOURCE_CHECKPOINTS {
        uuid id PK
        uuid source_id FK
        text dataset
        text cursor
        text cursor_version
        bigint revision
        timestamptz committed_at
    }
    INGESTION_MANIFESTS {
        uuid id PK
        uuid source_id FK
        text dataset
        text manifest_key
        text status
        text admission_digest
        int event_count
        int accepted_count
        int quarantined_count
        int duplicate_count
    }
    RAW_EVENT_REFERENCES {
        uuid id PK
        uuid source_id FK
        uuid manifest_id FK
        text object_ref UK
        text sha256
        int size_bytes
    }
    EVENT_INBOX {
        uuid id PK
        uuid source_id FK
        uuid manifest_id FK
        uuid raw_event_reference_id FK
        uuid record_id UK
        text idempotency_key
        text status
    }
    OUTBOX_MESSAGES {
        uuid id PK
        uuid message_id UK
        uuid source_id FK
        uuid aggregate_id FK
        text aggregate_type
        text message_type
        jsonb payload
        text status
    }
    QUARANTINED_EVENTS {
        uuid id PK
        uuid source_id FK
        uuid manifest_id FK
        uuid inbox_id FK
        uuid raw_event_reference_id FK
        uuid record_id FK
        text error_code
        text status
    }

    SOURCES ||--o| SOURCE_CHECKPOINTS : "cursor confirmado"
    SOURCES ||--o{ INGESTION_MANIFESTS : "fuente y dataset"
    INGESTION_MANIFESTS ||--o{ RAW_EVENT_REFERENCES : "origen del objeto"
    INGESTION_MANIFESTS ||--o{ EVENT_INBOX : "recepciones del lote"
    RAW_EVENT_REFERENCES ||--o{ EVENT_INBOX : "misma fuente y posible reutilizacion"
    INGESTION_MANIFESTS ||--o| OUTBOX_MESSAGES : "uno por comando confirmado"
    EVENT_INBOX ||--o{ QUARANTINED_EVENTS : "fallos de la recepcion"
