diff --git a/compatibility_v4_test.go b/compatibility_v4_test.go
new file mode 100644
index 0000000..13fc558
--- /dev/null
+++ b/compatibility_v4_test.go
@@ -0,0 +1,98 @@
+package auth0
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/go-jose/go-jose/v4"
+	"github.com/go-jose/go-jose/v4/jwt"
+)
+
+func TestV4RS256JWTAndJWKSCompatibility(t *testing.T) {
+	publicKey := defaultSecretRS256.Public()
+	publicKey.KeyID = "compat-rs256"
+	publicKey.Use = "sig"
+	jwks := JWKS{Keys: []jose.JSONWebKey{publicKey}}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		w.Header().Set("Content-Type", "application/jwk-set+json")
+		if err := json.NewEncoder(w).Encode(jwks); err != nil {
+			t.Error(err)
+		}
+	}))
+	defer server.Close()
+
+	provider := NewJWKClient(JWKClientOptions{URI: server.URL}, nil)
+	validator := NewValidator(NewConfiguration(provider, defaultAudience, defaultIssuer, jose.RS256), nil)
+
+	validToken := getTestTokenWithKid(defaultAudience, defaultIssuer, time.Now().Add(time.Hour), jose.RS256, defaultSecretRS256, "compat-rs256")
+	request := func(raw string) *http.Request {
+		req := httptest.NewRequest(http.MethodGet, "/", nil)
+		req.Header.Set("Authorization", "Bearer "+raw)
+		return req
+	}
+	if _, err := validator.ValidateRequest(request(validToken)); err != nil {
+		t.Fatalf("valid RS256 JWT from JWKS was rejected: %v", err)
+	}
+
+	wrongAudience := getTestTokenWithKid([]string{"another-api"}, defaultIssuer, time.Now().Add(time.Hour), jose.RS256, defaultSecretRS256, "compat-rs256")
+	if _, err := validator.ValidateRequest(request(wrongAudience)); !errors.Is(err, jwt.ErrInvalidAudience) {
+		t.Fatalf("wrong audience error = %v, want %v", err, jwt.ErrInvalidAudience)
+	}
+
+	wrongIssuer := getTestTokenWithKid(defaultAudience, "another-issuer", time.Now().Add(time.Hour), jose.RS256, defaultSecretRS256, "compat-rs256")
+	if _, err := validator.ValidateRequest(request(wrongIssuer)); !errors.Is(err, jwt.ErrInvalidIssuer) {
+		t.Fatalf("wrong issuer error = %v, want %v", err, jwt.ErrInvalidIssuer)
+	}
+
+	wrongAlgorithm := getTestTokenWithKid(defaultAudience, defaultIssuer, time.Now().Add(time.Hour), jose.HS256, defaultSecret, "compat-rs256")
+	if _, err := validator.ValidateRequest(request(wrongAlgorithm)); !errors.Is(err, ErrInvalidAlgorithm) {
+		t.Fatalf("wrong algorithm error = %v, want %v", err, ErrInvalidAlgorithm)
+	}
+}
+
+func oversizedRSAModulus() []byte {
+	// 513 bytes with the high bit set is exactly a 4097-bit modulus.
+	modulus := make([]byte, 513)
+	modulus[0] = 1
+	return modulus
+}
+
+func TestV4RejectsOversizedRSAJWKInJWKS(t *testing.T) {
+	modulus := base64.RawURLEncoding.EncodeToString(oversizedRSAModulus())
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		w.Header().Set("Content-Type", "application/jwk-set+json")
+		_, _ = fmt.Fprintf(w, `{"keys":[{"kty":"RSA","n":%q,"e":"AQAB"}]}`, modulus)
+	}))
+	defer server.Close()
+
+	client := NewJWKClient(JWKClientOptions{URI: server.URL}, nil)
+	_, err := client.downloadKeys()
+	if err == nil || !strings.Contains(err.Error(), "modulus too large") {
+		t.Fatalf("oversized JWKS RSA modulus error = %v, want modulus too large", err)
+	}
+}
+
+func TestV4RejectsOversizedRSAJWKInCompactJWTHeader(t *testing.T) {
+	protected, err := json.Marshal(map[string]interface{}{
+		"alg": "RS256",
+		"jwk": map[string]string{
+			"kty": "RSA",
+			"n":   base64.RawURLEncoding.EncodeToString(oversizedRSAModulus()),
+			"e":   "AQAB",
+		},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	compact := base64.RawURLEncoding.EncodeToString(protected) + ".e30.AA"
+	if _, err := ParseSignedToken(compact); err == nil || !strings.Contains(err.Error(), "modulus too large") {
+		t.Fatalf("oversized compact-JWT RSA modulus error = %v, want modulus too large", err)
+	}
+}
