+// supportedSignatureAlgorithms preserves the previous ParseSigned behavior of
+// parsing any supported JWS algorithm. Validation still enforces configured alg.
+var supportedSignatureAlgorithms = []jose.SignatureAlgorithm{
+	jose.EdDSA,
+	jose.HS256, jose.HS384, jose.HS512,
+	jose.RS256, jose.RS384, jose.RS512,
+	jose.ES256, jose.ES384, jose.ES512,
+	jose.PS256, jose.PS384, jose.PS512,
+}
+
+// ParseSignedToken parses a compact JWT while limiting parsing to supported
+// JOSE signature algorithms. JWTValidator applies configured algorithm policy.
+func ParseSignedToken(raw string) (*jwt.JSONWebToken, error) {
+	return jwt.ParseSigned(raw, supportedSignatureAlgorithms)
+}
