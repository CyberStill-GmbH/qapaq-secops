generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

// Los CHECK de UUIDv7, límites y estados están en la migración SQL.
// Los identificadores se proporcionan desde aplicación; no se generan en SQL.
model Source {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Text
  provider    String   @db.Text
  product     String   @db.Text
  dataset     String   @db.Text
  instanceKey String   @map("instance_key") @db.Text
  status      String   @default("planned") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @map("updated_at") @db.Timestamptz(3)

  checkpoint SourceCheckpoint?
  manifests  IngestionManifest[]

  @@unique([tenantId, provider, product, dataset, instanceKey], map: "sources_identity_key")
  @@unique([id, dataset], map: "sources_id_dataset_key")
  @@map("sources")
}

model SourceCheckpoint {
  id               String    @id @db.Uuid
  sourceId         String    @map("source_id") @db.Uuid
  dataset          String    @db.Text
  cursor           String    @db.Text
  cursorVersion    String    @map("cursor_version") @db.Text
  sourceGeneration String?   @map("source_generation") @db.Text
  lastOccurredAt   DateTime? @map("last_occurred_at") @db.Timestamptz(3)
  lastTieBreaker   String?   @map("last_tie_breaker") @db.Text
  revision         BigInt
  committedAt      DateTime  @map("committed_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @map("updated_at") @db.Timestamptz(3)

  source Source @relation(fields: [sourceId, dataset], references: [id, dataset], onDelete: Restrict, onUpdate: Restrict, map: "source_checkpoints_source_fkey")

  @@unique([sourceId, dataset], map: "source_checkpoints_source_dataset_key")
  @@map("source_checkpoints")
}

model IngestionManifest {
  id                     String    @id @db.Uuid
  sourceId               String    @map("source_id") @db.Uuid
  dataset                String    @db.Text
  manifestKey            String    @map("manifest_key") @db.Text
  status                 String    @default("durable") @db.Text
  admissionDigest        String    @map("admission_digest") @db.Text
  admissionFormatVersion String    @default("1") @map("admission_format_version") @db.Text
  cursorFrom             String?   @map("cursor_from") @db.Text
  cursorTo               String?   @map("cursor_to") @db.Text
  cursorVersion          String?   @map("cursor_version") @db.Text
  sourceGeneration       String?   @map("source_generation") @db.Text
  checkpointRevision     BigInt?   @map("checkpoint_revision")
  receivedAt             DateTime  @map("received_at") @db.Timestamptz(3)
  durableAt              DateTime  @map("durable_at") @db.Timestamptz(3)
  completedAt            DateTime? @map("completed_at") @db.Timestamptz(3)
  eventCount             Int       @map("event_count")
  acceptedCount          Int       @map("accepted_count")
  duplicateCount         Int       @default(0) @map("duplicate_count")
  quarantinedCount       Int       @map("quarantined_count")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @map("updated_at") @db.Timestamptz(3)

  source     Source              @relation(fields: [sourceId, dataset], references: [id, dataset], onDelete: Restrict, onUpdate: Restrict, map: "ingestion_manifests_source_fkey")
  rawObjects RawEventReference[]
  receipts   EventInbox[]
  messages   OutboxMessage[]

  @@unique([sourceId, manifestKey], map: "ingestion_manifests_source_key")
  @@unique([sourceId, id], map: "ingestion_manifests_source_id_key")
  @@index([sourceId, receivedAt, id], map: "ingestion_manifests_source_received_idx")
  @@map("ingestion_manifests")
}

model RawEventReference {
  id            String   @id @db.Uuid
  sourceId      String   @map("source_id") @db.Uuid
  manifestId    String   @map("manifest_id") @db.Uuid
  objectRef     String   @unique(map: "raw_event_references_object_ref_key") @map("object_ref") @db.Text
  objectVersion String?  @map("object_version") @db.Text
  sha256        String   @db.Text
  mediaType     String   @map("media_type") @db.Text
  sizeBytes     Int      @map("size_bytes")
  receivedAt    DateTime @map("received_at") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  manifest IngestionManifest @relation(fields: [sourceId, manifestId], references: [sourceId, id], onDelete: Restrict, onUpdate: Restrict, map: "raw_event_references_manifest_fkey")
  receipts EventInbox[]

  @@unique([sourceId, id], map: "raw_event_references_source_id_key")
  @@index([sourceId, manifestId, id], map: "raw_event_references_manifest_idx")
  @@map("raw_event_references")
}

model EventInbox {
  id                  String    @id @db.Uuid
  sourceId            String    @map("source_id") @db.Uuid
  manifestId          String    @map("manifest_id") @db.Uuid
  rawEventReferenceId String    @map("raw_event_reference_id") @db.Uuid
  recordId            String    @unique(map: "event_inbox_record_id_key") @map("record_id") @db.Uuid
  providerEventId     String?   @map("provider_event_id") @db.Text
  idempotencyKey      String    @map("idempotency_key") @db.Text
  status              String    @default("admitted") @db.Text
  attemptCount        Int       @default(0) @map("attempt_count")
  availableAt         DateTime  @map("available_at") @db.Timestamptz(3)
  processingStartedAt DateTime? @map("processing_started_at") @db.Timestamptz(3)
  processedAt         DateTime? @map("processed_at") @db.Timestamptz(3)
  lastErrorCode       String?   @map("last_error_code") @db.Text
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @map("updated_at") @db.Timestamptz(3)

  manifest   IngestionManifest  @relation(fields: [sourceId, manifestId], references: [sourceId, id], onDelete: Restrict, onUpdate: Restrict, map: "event_inbox_manifest_fkey")
  raw        RawEventReference  @relation(fields: [sourceId, rawEventReferenceId], references: [sourceId, id], onDelete: Restrict, onUpdate: Restrict, map: "event_inbox_raw_fkey")
  quarantine QuarantinedEvent[]

  @@unique([sourceId, idempotencyKey], map: "event_inbox_source_idempotency_key")
  @@unique([sourceId, manifestId, id, rawEventReferenceId, recordId], map: "event_inbox_receipt_key")
  @@index([sourceId, manifestId, id], map: "event_inbox_manifest_idx")
  @@index([sourceId, rawEventReferenceId], map: "event_inbox_raw_idx")
  @@map("event_inbox")
}

// La unicidad por agregado y el CHECK SQL limitan esta entrega a admisión.
model OutboxMessage {
  id                  String    @id @db.Uuid
  messageId           String    @unique(map: "outbox_messages_message_id_key") @map("message_id") @db.Uuid
  sourceId            String    @map("source_id") @db.Uuid
  aggregateId         String    @map("aggregate_id") @db.Uuid
  aggregateType       String    @map("aggregate_type") @db.Text
  messageType         String    @map("message_type") @db.Text
  schemaVersion       String    @map("schema_version") @db.Text
  idempotencyKey      String    @unique(map: "outbox_messages_idempotency_key") @map("idempotency_key") @db.Text
  payload             Json      @db.JsonB
  status              String    @default("pending") @db.Text
  attemptCount        Int       @default(0) @map("attempt_count")
  availableAt         DateTime  @map("available_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  processingStartedAt DateTime? @map("processing_started_at") @db.Timestamptz(3)
  publishedAt         DateTime? @map("published_at") @db.Timestamptz(3)
  lastErrorCode       String?   @map("last_error_code") @db.Text

  manifest IngestionManifest @relation(fields: [sourceId, aggregateId], references: [sourceId, id], onDelete: Restrict, onUpdate: Restrict, map: "outbox_messages_manifest_fkey")

  @@unique([aggregateType, aggregateId], map: "outbox_messages_aggregate_key")
  @@index([status, availableAt, id], map: "outbox_messages_pending_idx")
  @@map("outbox_messages")
}

model QuarantinedEvent {
  id                  String    @id @db.Uuid
  sourceId            String    @map("source_id") @db.Uuid
  manifestId          String    @map("manifest_id") @db.Uuid
  inboxId             String    @map("inbox_id") @db.Uuid
  rawEventReferenceId String    @map("raw_event_reference_id") @db.Uuid
  recordId            String    @map("record_id") @db.Uuid
  errorCode           String    @map("error_code") @db.Text
  errorPath           String?   @map("error_path") @db.Text
  contractVersion     String?   @map("contract_version") @db.Text
  parserVersion       String?   @map("parser_version") @db.Text
  status              String    @default("quarantined") @db.Text
  attemptCount        Int       @default(0) @map("attempt_count")
  quarantinedAt       DateTime  @map("quarantined_at") @db.Timestamptz(3)
  lastReprocessedAt   DateTime? @map("last_reprocessed_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @map("updated_at") @db.Timestamptz(3)

  inbox EventInbox @relation(fields: [sourceId, manifestId, inboxId, rawEventReferenceId, recordId], references: [sourceId, manifestId, id, rawEventReferenceId, recordId], onDelete: Restrict, onUpdate: Restrict, map: "quarantined_events_receipt_fkey")

  @@index([sourceId, manifestId, inboxId, rawEventReferenceId, recordId], map: "quarantined_events_receipt_idx")
  @@map("quarantined_events")
}

// C-24 persists references and lifecycle metadata only. Secret material is never a column.
model ManagedSecret {
  id             String    @id @db.Uuid
  logicalName    String    @unique(map: "managed_secrets_logical_name_key") @map("logical_name") @db.Text
  purpose        String    @db.Text
  owner          String    @db.Text
  classification String    @db.Text
  provider       String    @db.Text
  status         String    @db.Text
  currentVersion Int       @map("current_version")
  revision       Int
  createdAt      DateTime  @map("created_at") @db.Timestamptz(3)
  createdBy      String    @map("created_by") @db.Text
  updatedAt      DateTime  @map("updated_at") @db.Timestamptz(3)
  rotatedAt      DateTime? @map("rotated_at") @db.Timestamptz(3)
  rotatedBy      String?   @map("rotated_by") @db.Text
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedBy      String?   @map("revoked_by") @db.Text

  versions   SecretVersion[]
  operations SecretLifecycleOperation[]

  @@unique([id, currentVersion], map: "managed_secrets_current_version_key")
  @@map("managed_secrets")
}

model SecretVersion {
  secretId        String    @map("secret_id") @db.Uuid
  version         Int
  providerRef     String    @unique(map: "secret_versions_provider_ref_key") @map("provider_ref") @db.Text
  providerVersion String    @map("provider_version") @db.Text
  fingerprint     String    @db.Text
  status          String    @db.Text
  createdAt       DateTime  @map("created_at") @db.Timestamptz(3)
  createdBy       String    @map("created_by") @db.Text
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(3)
  supersededAt    DateTime? @map("superseded_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedBy       String?   @map("revoked_by") @db.Text

  secret ManagedSecret @relation(fields: [secretId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "secret_versions_secret_fkey")

  @@id([secretId, version])
  @@index([secretId, status], map: "secret_versions_status_idx")
  @@map("secret_versions")
}

model SecretLifecycleOperation {
  operationId String   @id @map("operation_id") @db.Text
  secretId    String   @map("secret_id") @db.Uuid
  operation   String   @db.Text
  version     Int
  completedAt DateTime @map("completed_at") @db.Timestamptz(3)

  secret ManagedSecret @relation(fields: [secretId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "secret_lifecycle_operations_secret_fkey")

  @@index([secretId, completedAt], map: "secret_lifecycle_operations_secret_idx")
  @@map("secret_lifecycle_operations")
}

model SecretLifecycleAudit {
  id            String   @id @db.Uuid
  secretId      String   @map("secret_id") @db.Uuid
  actorId       String   @map("actor_id") @db.Text
  action        String   @db.Text
  provider      String   @db.Text
  providerRef   String?  @map("provider_ref") @db.Text
  version       Int?
  fingerprint   String?  @db.Text
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz(3)
  result        String   @db.Text
  correlationId String   @map("correlation_id") @db.Text
  failureClass  String?  @map("failure_class") @db.Text

  @@index([secretId, occurredAt, id], map: "secret_lifecycle_audit_secret_idx")
  @@map("secret_lifecycle_audit")
}

model SecretReconciliation {
  id              String    @id @db.Uuid
  operationId     String    @unique(map: "secret_reconciliations_operation_key") @map("operation_id") @db.Text
  secretId        String    @map("secret_id") @db.Uuid
  logicalName     String    @map("logical_name") @db.Text
  operation       String    @db.Text
  provider        String    @db.Text
  providerRef     String?   @map("provider_ref") @db.Text
  fingerprint     String?   @db.Text
  intendedVersion Int       @map("intended_version")
  reason          String    @db.Text
  actorId         String    @map("actor_id") @db.Text
  correlationId   String    @map("correlation_id") @db.Text
  createdAt       DateTime  @map("created_at") @db.Timestamptz(3)
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz(3)
  resolvedBy      String?   @map("resolved_by") @db.Text

  @@index([reason, createdAt], map: "secret_reconciliations_pending_idx")
  @@map("secret_reconciliations")
}

// C-19 — AuditEvent append-only con cadena de hash por tenant.
// Los privilegios de UPDATE/DELETE se revocan en la migración; el trigger impide
// la modificación incluso para un rol con permisos.
model AuditEvent {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Text
  sequence      BigInt
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz(3)
  recordedAt    DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)
  actorId       String   @map("actor_id") @db.Text
  actorType     String   @map("actor_type") @db.Text
  actorSession  String?  @map("actor_session") @db.Text
  actorIp       String?  @map("actor_ip") @db.Text
  action        String   @db.Text
  resourceType  String   @map("resource_type") @db.Text
  resourceId    String   @map("resource_id") @db.Text
  outcome       String   @db.Text
  correlationId String   @map("correlation_id") @db.Text
  reason        String?  @db.Text
  metadata      Json?    @db.JsonB
  previousHash  String   @map("previous_hash") @db.Text
  hash          String   @db.Text

  @@unique([tenantId, sequence], map: "audit_events_tenant_sequence_key")
  @@unique([tenantId, hash], map: "audit_events_tenant_hash_key")
  @@index([tenantId, occurredAt, sequence], map: "audit_events_tenant_time_idx")
  @@index([tenantId, action, occurredAt], map: "audit_events_action_idx")
  @@map("audit_events")
}

// C-16 — candidato de detección. La unicidad por clave de idempotencia es lo que
// hace que repetir la promoción no cree un segundo candidato.
model DetectionCandidate {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Text
  eventRecordId  String   @map("event_record_id") @db.Uuid
  eventUid       String   @map("event_uid") @db.Text
  idempotencyKey String   @map("idempotency_key") @db.Text
  priority       String   @db.Text
  score          Int
  reasons        Json     @db.JsonB
  rulesetId      String   @map("ruleset_id") @db.Text
  rulesetVersion String   @map("ruleset_version") @db.Text
  title          String   @db.Text
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  alert SocAlert?

  @@unique([tenantId, idempotencyKey], map: "detection_candidates_idempotency_key")
  @@index([tenantId, occurredAt, id], map: "detection_candidates_time_idx")
  @@map("detection_candidates")
}

// C-17 — alerta SOC. `revision` sostiene el compare-and-set del dominio.
model SocAlert {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Text
  candidateId   String    @unique(map: "soc_alerts_candidate_key") @map("candidate_id") @db.Uuid
  eventRecordId String    @map("event_record_id") @db.Uuid
  title         String    @db.Text
  priority      String    @db.Text
  score         Int
  reasons       Json      @db.JsonB
  status        String    @db.Text
  assigneeId    String?   @map("assignee_id") @db.Text
  verdict       String?   @db.Text
  triageNote    String?   @map("triage_note") @db.Text
  incidentId    String?   @map("incident_id") @db.Uuid
  occurredAt    DateTime  @map("occurred_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @map("updated_at") @db.Timestamptz(3)
  revision      Int

  candidate DetectionCandidate @relation(fields: [candidateId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "soc_alerts_candidate_fkey")
  incident  SocIncident?       @relation(fields: [incidentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "soc_alerts_incident_fkey")

  @@index([tenantId, status, occurredAt], map: "soc_alerts_board_idx")
  @@index([tenantId, incidentId], map: "soc_alerts_incident_idx")
  @@map("soc_alerts")
}

// C-17 — incidente/caso mínimo.
model SocIncident {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Text
  title         String    @db.Text
  severity      String    @db.Text
  status        String    @db.Text
  ownerId       String    @map("owner_id") @db.Text
  summary       String    @db.Text
  openedAt      DateTime  @map("opened_at") @db.Timestamptz(3)
  updatedAt     DateTime  @map("updated_at") @db.Timestamptz(3)
  closedAt      DateTime? @map("closed_at") @db.Timestamptz(3)
  closureReason String?   @map("closure_reason") @db.Text
  revision      Int

  alerts SocAlert[]

  @@index([tenantId, status, openedAt], map: "soc_incidents_board_idx")
  @@map("soc_incidents")
}

// C-20 — intento de notificación. `client_request_id` es estable entre reintentos
// para que el destino pueda deduplicar un envío ambiguo.
model NotificationAttempt {
  id              String    @id @db.Uuid
  tenantId        String    @map("tenant_id") @db.Text
  messageId       String    @map("message_id") @db.Uuid
  idempotencyKey  String    @map("idempotency_key") @db.Text
  clientRequestId String    @map("client_request_id") @db.Text
  channel         String    @db.Text
  status          String    @db.Text
  attemptCount    Int       @map("attempt_count")
  availableAt     DateTime  @map("available_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @map("updated_at") @db.Timestamptz(3)
  lastFailureCode String?   @map("last_failure_code") @db.Text
  lastFailureClass String?  @map("last_failure_class") @db.Text
  sentAt          DateTime? @map("sent_at") @db.Timestamptz(3)
  acknowledgedAt  DateTime? @map("acknowledged_at") @db.Timestamptz(3)
  acknowledgedBy  String?   @map("acknowledged_by") @db.Text

  @@unique([tenantId, idempotencyKey], map: "notification_attempts_idempotency_key")
  @@index([status, availableAt, id], map: "notification_attempts_pending_idx")
  @@map("notification_attempts")
}
