generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

// Los CHECK de UUIDv7, límites y estados están en la migración SQL.
// Los identificadores se proporcionan desde aplicación; no se generan en SQL.
model Source {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Text
  provider    String   @db.Text
  product     String   @db.Text
  dataset     String   @db.Text
  instanceKey String   @map("instance_key") @db.Text
  status      String   @default("planned") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @map("updated_at") @db.Timestamptz(3)

  checkpoint SourceCheckpoint?
  manifests  IngestionManifest[]

  @@unique([tenantId, provider, product, dataset, instanceKey], map: "sources_identity_key")
  @@unique([id, dataset], map: "sources_id_dataset_key")
  @@map("sources")
}

model SourceCheckpoint {
  id               String    @id @db.Uuid
  sourceId         String    @map("source_id") @db.Uuid
  dataset          String    @db.Text
  cursor           String    @db.Text
  cursorVersion    String    @map("cursor_version") @db.Text
  sourceGeneration String?   @map("source_generation") @db.Text
  lastOccurredAt   DateTime? @map("last_occurred_at") @db.Timestamptz(3)
  lastTieBreaker   String?   @map("last_tie_breaker") @db.Text
  revision         BigInt
  committedAt      DateTime  @map("committed_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @map("updated_at") @db.Timestamptz(3)

  source Source @relation(fields: [sourceId, dataset], references: [id, dataset], onDelete: Restrict, onUpdate: Restrict, map: "source_checkpoints_source_fkey")

  @@unique([sourceId, dataset], map: "source_checkpoints_source_dataset_key")
  @@map("source_checkpoints")
}

model IngestionManifest {
  id                     String    @id @db.Uuid
  sourceId               String    @map("source_id") @db.Uuid
  dataset                String    @db.Text
  manifestKey            String    @map("manifest_key") @db.Text
  status                 String    @default("durable") @db.Text
  admissionDigest        String    @map("admission_digest") @db.Text
  admissionFormatVersion String    @default("1") @map("admission_format_version") @db.Text
  cursorFrom             String?   @map("cursor_from") @db.Text
  cursorTo               String?   @map("cursor_to") @db.Text
  cursorVersion          String?   @map("cursor_version") @db.Text
  sourceGeneration       String?   @map("source_generation") @db.Text
  checkpointRevision     BigInt?   @map("checkpoint_revision")
  receivedAt             DateTime  @map("received_at") @db.Timestamptz(3)
  durableAt              DateTime  @map("durable_at") @db.Timestamptz(3)
  completedAt            DateTime? @map("completed_at") @db.Timestamptz(3)
  eventCount             Int       @map("event_count")
  acceptedCount          Int       @map("accepted_count")
  duplicateCount         Int       @default(0) @map("duplicate_count")
  quarantinedCount       Int       @map("quarantined_count")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @map("updated_at") @db.Timestamptz(3)

  source     Source              @relation(fields: [sourceId, dataset], references: [id, dataset], onDelete: Restrict, onUpdate: Restrict, map: "ingestion_manifests_source_fkey")
  rawObjects RawEventReference[]
  receipts   EventInbox[]
  messages   OutboxMessage[]

  @@unique([sourceId, manifestKey], map: "ingestion_manifests_source_key")
  @@unique([sourceId, id], map: "ingestion_manifests_source_id_key")
  @@index([sourceId, receivedAt, id], map: "ingestion_manifests_source_received_idx")
  @@map("ingestion_manifests")
}

model RawEventReference {
  id            String   @id @db.Uuid
  sourceId      String   @map("source_id") @db.Uuid
  manifestId    String   @map("manifest_id") @db.Uuid
  objectRef     String   @unique(map: "raw_event_references_object_ref_key") @map("object_ref") @db.Text
  objectVersion String?  @map("object_version") @db.Text
  sha256        String   @db.Text
  mediaType     String   @map("media_type") @db.Text
  sizeBytes     Int      @map("size_bytes")
  receivedAt    DateTime @map("received_at") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  manifest IngestionManifest @relation(fields: [sourceId, manifestId], references: [sourceId, id], onDelete: Restrict, onUpdate: Restrict, map: "raw_event_references_manifest_fkey")
  receipts EventInbox[]

  @@unique([sourceId, id], map: "raw_event_references_source_id_key")
  @@index([sourceId, manifestId, id], map: "raw_event_references_manifest_idx")
  @@map("raw_event_references")
}

model EventInbox {
  id                  String    @id @db.Uuid
  sourceId            String    @map("source_id") @db.Uuid
  manifestId          String    @map("manifest_id") @db.Uuid
  rawEventReferenceId String    @map("raw_event_reference_id") @db.Uuid
  recordId            String    @unique(map: "event_inbox_record_id_key") @map("record_id") @db.Uuid
  providerEventId     String?   @map("provider_event_id") @db.Text
  idempotencyKey      String    @map("idempotency_key") @db.Text
  status              String    @default("admitted") @db.Text
  attemptCount        Int       @default(0) @map("attempt_count")
  availableAt         DateTime  @map("available_at") @db.Timestamptz(3)
  processingStartedAt DateTime? @map("processing_started_at") @db.Timestamptz(3)
  processedAt         DateTime? @map("processed_at") @db.Timestamptz(3)
  lastErrorCode       String?   @map("last_error_code") @db.Text
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @map("updated_at") @db.Timestamptz(3)

  manifest   IngestionManifest  @relation(fields: [sourceId, manifestId], references: [sourceId, id], onDelete: Restrict, onUpdate: Restrict, map: "event_inbox_manifest_fkey")
  raw        RawEventReference  @relation(fields: [sourceId, rawEventReferenceId], references: [sourceId, id], onDelete: Restrict, onUpdate: Restrict, map: "event_inbox_raw_fkey")
  quarantine QuarantinedEvent[]

  @@unique([sourceId, idempotencyKey], map: "event_inbox_source_idempotency_key")
  @@unique([sourceId, manifestId, id, rawEventReferenceId, recordId], map: "event_inbox_receipt_key")
  @@index([sourceId, manifestId, id], map: "event_inbox_manifest_idx")
  @@index([sourceId, rawEventReferenceId], map: "event_inbox_raw_idx")
  @@map("event_inbox")
}

// La unicidad por agregado y el CHECK SQL limitan esta entrega a admisión.
model OutboxMessage {
  id                  String    @id @db.Uuid
  messageId           String    @unique(map: "outbox_messages_message_id_key") @map("message_id") @db.Uuid
  sourceId            String    @map("source_id") @db.Uuid
  aggregateId         String    @map("aggregate_id") @db.Uuid
  aggregateType       String    @map("aggregate_type") @db.Text
  messageType         String    @map("message_type") @db.Text
  schemaVersion       String    @map("schema_version") @db.Text
  idempotencyKey      String    @unique(map: "outbox_messages_idempotency_key") @map("idempotency_key") @db.Text
  payload             Json      @db.JsonB
  status              String    @default("pending") @db.Text
  attemptCount        Int       @default(0) @map("attempt_count")
  availableAt         DateTime  @map("available_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  processingStartedAt DateTime? @map("processing_started_at") @db.Timestamptz(3)
  publishedAt         DateTime? @map("published_at") @db.Timestamptz(3)
  lastErrorCode       String?   @map("last_error_code") @db.Text

  manifest IngestionManifest @relation(fields: [sourceId, aggregateId], references: [sourceId, id], onDelete: Restrict, onUpdate: Restrict, map: "outbox_messages_manifest_fkey")

  @@unique([aggregateType, aggregateId], map: "outbox_messages_aggregate_key")
  @@index([status, availableAt, id], map: "outbox_messages_pending_idx")
  @@map("outbox_messages")
}

model QuarantinedEvent {
  id                  String    @id @db.Uuid
  sourceId            String    @map("source_id") @db.Uuid
  manifestId          String    @map("manifest_id") @db.Uuid
  inboxId             String    @map("inbox_id") @db.Uuid
  rawEventReferenceId String    @map("raw_event_reference_id") @db.Uuid
  recordId            String    @map("record_id") @db.Uuid
  errorCode           String    @map("error_code") @db.Text
  errorPath           String?   @map("error_path") @db.Text
  contractVersion     String?   @map("contract_version") @db.Text
  parserVersion       String?   @map("parser_version") @db.Text
  status              String    @default("quarantined") @db.Text
  attemptCount        Int       @default(0) @map("attempt_count")
  quarantinedAt       DateTime  @map("quarantined_at") @db.Timestamptz(3)
  lastReprocessedAt   DateTime? @map("last_reprocessed_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @map("updated_at") @db.Timestamptz(3)

  inbox EventInbox @relation(fields: [sourceId, manifestId, inboxId, rawEventReferenceId, recordId], references: [sourceId, manifestId, id, rawEventReferenceId, recordId], onDelete: Restrict, onUpdate: Restrict, map: "quarantined_events_receipt_fkey")

  @@index([sourceId, manifestId, inboxId, rawEventReferenceId, recordId], map: "quarantined_events_receipt_idx")
  @@map("quarantined_events")
}

// C-24 persists references and lifecycle metadata only. Secret material is never a column.
model ManagedSecret {
  id             String    @id @db.Uuid
  logicalName    String    @unique(map: "managed_secrets_logical_name_key") @map("logical_name") @db.Text
  purpose        String    @db.Text
  owner          String    @db.Text
  classification String    @db.Text
  provider       String    @db.Text
  status         String    @db.Text
  currentVersion Int       @map("current_version")
  revision       Int
  createdAt      DateTime  @map("created_at") @db.Timestamptz(3)
  createdBy      String    @map("created_by") @db.Text
  updatedAt      DateTime  @map("updated_at") @db.Timestamptz(3)
  rotatedAt      DateTime? @map("rotated_at") @db.Timestamptz(3)
  rotatedBy      String?   @map("rotated_by") @db.Text
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedBy      String?   @map("revoked_by") @db.Text

  versions   SecretVersion[]
  operations SecretLifecycleOperation[]

  @@unique([id, currentVersion], map: "managed_secrets_current_version_key")
  @@map("managed_secrets")
}

model SecretVersion {
  secretId        String    @map("secret_id") @db.Uuid
  version         Int
  providerRef     String    @unique(map: "secret_versions_provider_ref_key") @map("provider_ref") @db.Text
  providerVersion String    @map("provider_version") @db.Text
  fingerprint     String    @db.Text
  status          String    @db.Text
  createdAt       DateTime  @map("created_at") @db.Timestamptz(3)
  createdBy       String    @map("created_by") @db.Text
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(3)
  supersededAt    DateTime? @map("superseded_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedBy       String?   @map("revoked_by") @db.Text

  secret ManagedSecret @relation(fields: [secretId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "secret_versions_secret_fkey")

  @@id([secretId, version])
  @@index([secretId, status], map: "secret_versions_status_idx")
  @@map("secret_versions")
}

model SecretLifecycleOperation {
  operationId String   @id @map("operation_id") @db.Text
  secretId    String   @map("secret_id") @db.Uuid
  operation   String   @db.Text
  version     Int
  completedAt DateTime @map("completed_at") @db.Timestamptz(3)

  secret ManagedSecret @relation(fields: [secretId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "secret_lifecycle_operations_secret_fkey")

  @@index([secretId, completedAt], map: "secret_lifecycle_operations_secret_idx")
  @@map("secret_lifecycle_operations")
}

model SecretLifecycleAudit {
  id            String   @id @db.Uuid
  secretId      String   @map("secret_id") @db.Uuid
  actorId       String   @map("actor_id") @db.Text
  action        String   @db.Text
  provider      String   @db.Text
  providerRef   String?  @map("provider_ref") @db.Text
  version       Int?
  fingerprint   String?  @db.Text
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz(3)
  result        String   @db.Text
  correlationId String   @map("correlation_id") @db.Text
  failureClass  String?  @map("failure_class") @db.Text

  @@index([secretId, occurredAt, id], map: "secret_lifecycle_audit_secret_idx")
  @@map("secret_lifecycle_audit")
}

model SecretReconciliation {
  id              String    @id @db.Uuid
  operationId     String    @unique(map: "secret_reconciliations_operation_key") @map("operation_id") @db.Text
  secretId        String    @map("secret_id") @db.Uuid
  logicalName     String    @map("logical_name") @db.Text
  operation       String    @db.Text
  provider        String    @db.Text
  providerRef     String?   @map("provider_ref") @db.Text
  fingerprint     String?   @db.Text
  intendedVersion Int       @map("intended_version")
  reason          String    @db.Text
  actorId         String    @map("actor_id") @db.Text
  correlationId   String    @map("correlation_id") @db.Text
  createdAt       DateTime  @map("created_at") @db.Timestamptz(3)
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz(3)
  resolvedBy      String?   @map("resolved_by") @db.Text

  @@index([reason, createdAt], map: "secret_reconciliations_pending_idx")
  @@map("secret_reconciliations")
}

// C-19 — AuditEvent append-only con cadena de hash por tenant.
// Los privilegios de UPDATE/DELETE se revocan en la migración; el trigger impide
// la modificación incluso para un rol con permisos.
model AuditEvent {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Text
  sequence      BigInt
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz(3)
  recordedAt    DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)
  actorId       String   @map("actor_id") @db.Text
  actorType     String   @map("actor_type") @db.Text
  actorSession  String?  @map("actor_session") @db.Text
  actorIp       String?  @map("actor_ip") @db.Text
  action        String   @db.Text
  resourceType  String   @map("resource_type") @db.Text
  resourceId    String   @map("resource_id") @db.Text
  outcome       String   @db.Text
  correlationId String   @map("correlation_id") @db.Text
  reason        String?  @db.Text
  metadata      Json?    @db.JsonB
  previousHash  String   @map("previous_hash") @db.Text
  hash          String   @db.Text

  @@unique([tenantId, sequence], map: "audit_events_tenant_sequence_key")
  @@unique([tenantId, hash], map: "audit_events_tenant_hash_key")
  @@index([tenantId, occurredAt, sequence], map: "audit_events_tenant_time_idx")
  @@index([tenantId, action, occurredAt], map: "audit_events_action_idx")
  @@map("audit_events")
}

// C-16 — candidato de detección. La unicidad por clave de idempotencia es lo que
// hace que repetir la promoción no cree un segundo candidato.
model DetectionCandidate {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Text
  eventRecordId  String   @map("event_record_id") @db.Uuid
  eventUid       String   @map("event_uid") @db.Text
  idempotencyKey String   @map("idempotency_key") @db.Text
  priority       String   @db.Text
  score          Int
  reasons        Json     @db.JsonB
  rulesetId      String   @map("ruleset_id") @db.Text
  rulesetVersion String   @map("ruleset_version") @db.Text
  title          String   @db.Text
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  // C-16 1.1.0 — índice de correlación por entidad.
  entityKeys      String[] @default([]) @map("entity_keys") @db.Text
  signal          String?  @db.Text
  ruleId          String?  @map("rule_id") @db.Text
  relatedAlertIds String[] @default([]) @map("related_alert_ids") @db.Uuid

  alert SocAlert?

  @@unique([tenantId, idempotencyKey], map: "detection_candidates_idempotency_key")
  @@index([tenantId, occurredAt, id], map: "detection_candidates_time_idx")
  @@map("detection_candidates")
}

// C-17 — alerta SOC. `revision` sostiene el compare-and-set del dominio.
model SocAlert {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Text
  candidateId   String    @unique(map: "soc_alerts_candidate_key") @map("candidate_id") @db.Uuid
  eventRecordId String    @map("event_record_id") @db.Uuid
  title         String    @db.Text
  priority      String    @db.Text
  score         Int
  reasons       Json      @db.JsonB
  status        String    @db.Text
  assigneeId    String?   @map("assignee_id") @db.Text
  verdict       String?   @db.Text
  triageNote    String?   @map("triage_note") @db.Text
  incidentId    String?   @map("incident_id") @db.Uuid
  occurredAt    DateTime  @map("occurred_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @map("updated_at") @db.Timestamptz(3)
  revision      Int
  // C-16 1.1.0 — copia de la correlación del candidato para consultar sin join.
  entityKeys      String[] @default([]) @map("entity_keys") @db.Text
  // D-10b — referencias opacas de las mismas entidades: lo único que viaja en URLs.
  entityRefs      String[] @default([]) @map("entity_refs") @db.Text
  signal          String?  @db.Text
  ruleId          String?  @map("rule_id") @db.Text
  relatedAlertIds String[] @default([]) @map("related_alert_ids") @db.Uuid

  candidate DetectionCandidate @relation(fields: [candidateId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "soc_alerts_candidate_fkey")
  incident  SocIncident?       @relation(fields: [incidentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "soc_alerts_incident_fkey")

  @@index([tenantId, status, occurredAt], map: "soc_alerts_board_idx")
  @@index([tenantId, incidentId], map: "soc_alerts_incident_idx")
  @@index([entityKeys], map: "soc_alerts_entity_keys_idx", type: Gin)
  @@index([entityRefs], map: "soc_alerts_entity_refs_idx", type: Gin)
  @@index([tenantId, occurredAt(sort: Desc), id], map: "soc_alerts_tenant_time_idx")
  @@index([tenantId, eventRecordId], map: "soc_alerts_event_record_idx")
  @@map("soc_alerts")
}

// C-17/C-20 — outbox del SOC: cola durable con lease que el despacho reclama de forma
// atómica. Separado del outbox de admisión de C-04, que tiene FK a manifiestos de ingesta.
model SocOutboxMessage {
  messageId      String    @id @map("message_id") @db.Uuid
  tenantId       String    @map("tenant_id") @db.Text
  aggregateType  String    @map("aggregate_type") @db.Text
  aggregateId    String    @map("aggregate_id") @db.Uuid
  messageType    String    @map("message_type") @db.Text
  schemaVersion  String    @map("schema_version") @db.Text
  idempotencyKey String    @unique(map: "soc_outbox_messages_idempotency_key") @map("idempotency_key") @db.Text
  payload        Json      @db.JsonB
  availableAt    DateTime  @map("available_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  status         String    @default("pending") @db.Text
  attemptCount   Int       @default(0) @map("attempt_count")
  leaseUntil     DateTime? @map("lease_until") @db.Timestamptz(3)
  claimId        String?   @map("claim_id") @db.Uuid
  lastErrorCode  String?   @map("last_error_code") @db.Text
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(3)

  @@map("soc_outbox_messages")
}

// C-17 — incidente/caso mínimo.
model SocIncident {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Text
  title         String    @db.Text
  severity      String    @db.Text
  status        String    @db.Text
  ownerId       String    @map("owner_id") @db.Text
  summary       String    @db.Text
  openedAt      DateTime  @map("opened_at") @db.Timestamptz(3)
  updatedAt     DateTime  @map("updated_at") @db.Timestamptz(3)
  closedAt      DateTime? @map("closed_at") @db.Timestamptz(3)
  closureReason String?   @map("closure_reason") @db.Text
  revision      Int

  alerts SocAlert[]
  tasks  IncidentTask[]
  notes  IncidentNote[]

  @@index([tenantId, status, openedAt], map: "soc_incidents_board_idx")
  @@map("soc_incidents")
}

// Sprint 5 · fase 4 — tarea asignable del incidente. `revision` sostiene compare-and-set.
model IncidentTask {
  id                 String    @id @db.Uuid
  tenantId           String    @map("tenant_id") @db.Text
  incidentId         String    @map("incident_id") @db.Uuid
  title              String    @db.Text
  description        String    @default("") @db.Text
  status             String    @db.Text
  required           Boolean
  assigneeId         String?   @map("assignee_id") @db.Text
  dueAt              DateTime? @map("due_at") @db.Timestamptz(3)
  createdBy          String    @map("created_by") @db.Text
  createdAt          DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @map("updated_at") @db.Timestamptz(3)
  completedAt        DateTime? @map("completed_at") @db.Timestamptz(3)
  cancellationReason String?   @map("cancellation_reason") @db.Text
  revision           Int

  incident SocIncident @relation(fields: [incidentId], references: [id], onDelete: Restrict, map: "incident_tasks_incident_fk")

  @@index([tenantId, incidentId, createdAt(sort: Desc)], map: "incident_tasks_incident_idx")
  @@map("incident_tasks")
}

// Sprint 5 · fase 4 — bitácora append-only; una corrección es otra fila (`correctsNoteId`).
model IncidentNote {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Text
  incidentId     String   @map("incident_id") @db.Uuid
  authorId       String   @map("author_id") @db.Text
  body           String   @db.Text
  createdAt      DateTime @map("created_at") @db.Timestamptz(3)
  correctsNoteId String?  @map("corrects_note_id") @db.Uuid

  incident    SocIncident    @relation(fields: [incidentId], references: [id], onDelete: Restrict, map: "incident_notes_incident_fk")
  corrects    IncidentNote?  @relation("NoteCorrections", fields: [correctsNoteId], references: [id], onDelete: Restrict, map: "incident_notes_corrects_fk")
  correctedBy IncidentNote[] @relation("NoteCorrections")

  @@index([tenantId, incidentId, createdAt(sort: Desc)], map: "incident_notes_incident_idx")
  @@map("incident_notes")
}

// C-20 — intento de notificación. `client_request_id` es estable entre reintentos
// para que el destino pueda deduplicar un envío ambiguo.
model NotificationAttempt {
  id              String    @id @db.Uuid
  tenantId        String    @map("tenant_id") @db.Text
  messageId       String    @map("message_id") @db.Uuid
  idempotencyKey  String    @map("idempotency_key") @db.Text
  clientRequestId String    @map("client_request_id") @db.Text
  channel         String    @db.Text
  status          String    @db.Text
  attemptCount    Int       @map("attempt_count")
  availableAt     DateTime  @map("available_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @map("updated_at") @db.Timestamptz(3)
  lastFailureCode String?   @map("last_failure_code") @db.Text
  lastFailureClass String?  @map("last_failure_class") @db.Text
  sentAt          DateTime? @map("sent_at") @db.Timestamptz(3)
  acknowledgedAt  DateTime? @map("acknowledged_at") @db.Timestamptz(3)
  acknowledgedBy  String?   @map("acknowledged_by") @db.Text

  @@unique([tenantId, idempotencyKey], map: "notification_attempts_idempotency_key")
  @@index([status, availableAt, id], map: "notification_attempts_pending_idx")
  @@map("notification_attempts")
}

// C-18/C-25 — sesiones del BFF. `idHash` es el SHA-256 del identificador de la cookie: el
// valor original nunca se guarda.
model AccessSession {
  subjectOid        String?   @map("subject_oid") @db.Text
  idHash            String    @id @map("id_hash") @db.Text
  tenantId          String    @map("tenant_id") @db.Text
  subjectId         String    @map("subject_id") @db.Text
  displayName       String?   @map("display_name") @db.Text
  email             String?   @db.Text
  state             String    @db.Text
  roles             String[]  @default([]) @db.Text
  scopes            String[]  @default([]) @db.Text
  capabilities      String[]  @default([]) @db.Text
  amr               String[]  @default([]) @db.Text
  createdAt         DateTime  @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime  @map("last_seen_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  idpSessionId      String?   @map("idp_session_id") @db.Text
  clientIp          String    @map("client_ip") @db.Text
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  revocationReason  String?   @map("revocation_reason") @db.Text
  revision          Int

  @@index([tenantId, subjectId, state], map: "access_sessions_subject_idx")
  @@index([tenantId, lastSeenAt(sort: Desc)], map: "access_sessions_tenant_seen_idx")
  @@map("access_sessions")
}

// Sprint 5 · fase 0 — cursor de ingesta por fuente, con lease y fencing (`claimId`).
model SocIngestionCursor {
  tenantId   String    @map("tenant_id") @db.Text
  sourceId   String    @map("source_id") @db.Text
  dataset    String    @db.Text
  watermark  DateTime? @db.Timestamptz(3)
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz(3)
  claimId    String?   @map("claim_id") @db.Uuid
  updatedAt  DateTime  @map("updated_at") @db.Timestamptz(3)

  @@id([tenantId, sourceId, dataset], map: "soc_ingestion_cursors_pkey")
  @@map("soc_ingestion_cursors")
}

// Sprint 5 · fase 0 — observación de cada pasada de ingesta; base de la salud por fuente.
model SourcePollObservation {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Text
  sourceId      String    @map("source_id") @db.Text
  dataset       String    @db.Text
  attemptedAt   DateTime  @map("attempted_at") @db.Timestamptz(3)
  completedAt   DateTime  @map("completed_at") @db.Timestamptz(3)
  outcome       String    @db.Text
  recordsSeen   Int       @map("records_seen")
  promoted      Int
  quarantined   Int
  newestEventAt DateTime? @map("newest_event_at") @db.Timestamptz(3)
  errorClass    String?   @map("error_class") @db.Text

  @@index([tenantId, sourceId, dataset, attemptedAt(sort: Desc)], map: "source_poll_observations_recent_idx")
  @@map("source_poll_observations")
}

// Sprint 5 · fase 2 — bitácora append-only de la salud de cada fuente.
model SourceHealthTransition {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Text
  sourceId  String   @map("source_id") @db.Text
  dataset   String   @db.Text
  fromState String?  @map("from_state") @db.Text
  toState   String   @map("to_state") @db.Text
  reason    String   @db.Text
  at        DateTime @db.Timestamptz(3)

  @@index([tenantId, sourceId, dataset, at(sort: Desc)], map: "source_health_transitions_recent_idx")
  @@map("source_health_transitions")
}

// Sprint 5 · fase 3 — estado de sincronización del padrón, con lease y enlace delta.
model DirectorySyncState {
  tenantId       String    @map("tenant_id") @db.Text
  groupId        String    @map("group_id") @db.Uuid
  deltaLink      String?   @map("delta_link") @db.Text
  status         String    @db.Text
  lastAttemptAt  DateTime? @map("last_attempt_at") @db.Timestamptz(3)
  lastSuccessAt  DateTime? @map("last_success_at") @db.Timestamptz(3)
  lastErrorClass String?   @map("last_error_class") @db.Text
  leaseUntil     DateTime? @map("lease_until") @db.Timestamptz(3)
  claimId        String?   @map("claim_id") @db.Uuid

  @@id([tenantId, groupId], map: "directory_sync_state_pkey")
  @@map("directory_sync_state")
}

// Sprint 5 · fase 3 — miembros del grupo de admisión (bajas como estado, no como borrado).
model DirectoryMember {
  tenantId       String   @map("tenant_id") @db.Text
  groupId        String   @map("group_id") @db.Uuid
  oid            String   @db.Uuid
  displayName    String?  @map("display_name") @db.Text
  upn            String?  @db.Text
  accountEnabled Boolean? @map("account_enabled")
  membership     String   @db.Text
  syncedAt       DateTime @map("synced_at") @db.Timestamptz(3)

  @@id([tenantId, groupId, oid], map: "directory_members_pkey")
  @@map("directory_members")
}

// Sprint 5 · fase 3 — dueños del grupo; `active = false` cuando dejan de serlo.
model DirectoryOwner {
  tenantId    String   @map("tenant_id") @db.Text
  groupId     String   @map("group_id") @db.Uuid
  oid         String   @db.Uuid
  displayName String?  @map("display_name") @db.Text
  upn         String?  @db.Text
  active      Boolean
  syncedAt    DateTime @map("synced_at") @db.Timestamptz(3)

  @@id([tenantId, groupId, oid], map: "directory_owners_pkey")
  @@map("directory_owners")
}

// Sprint 5 · fase 2 — actividad medida por stream de la fuente (informativa).
model SourceStreamActivity {
  tenantId       String    @map("tenant_id") @db.Text
  sourceId       String    @map("source_id") @db.Text
  dataset        String    @db.Text
  stream         String    @db.Text
  lastEventAt    DateTime? @map("last_event_at") @db.Timestamptz(3)
  eventsInWindow Int       @map("events_in_window")
  windowHours    Int       @map("window_hours")
  measuredAt     DateTime  @map("measured_at") @db.Timestamptz(3)

  @@id([tenantId, sourceId, dataset, stream], map: "source_stream_activity_pkey")
  @@map("source_stream_activity")
}

// Sprint 5 — dispositivos para avisos Web Push (sin contenido); revocar = `revokedAt`.
model PushSubscription {
  id               String    @id @db.Uuid
  tenantId         String    @map("tenant_id") @db.Text
  subjectKey       String    @map("subject_key") @db.Text
  endpoint         String    @db.Text
  p256dh           String    @db.Text
  auth             String    @db.Text
  label            String    @db.Text
  createdAt        DateTime  @map("created_at") @db.Timestamptz(3)
  lastSuccessAt    DateTime? @map("last_success_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  revocationReason String?   @map("revocation_reason") @db.Text

  @@unique([tenantId, endpoint], map: "push_subscriptions_endpoint_key")
  @@map("push_subscriptions")
}

// Reputación de archivos por hash: último resultado por tenant, servicio y hash (24 h). Vencido
// se reemplaza con UPSERT; sin DELETE.
model FileReputationCache {
  tenantId  String   @map("tenant_id") @db.Text
  provider  String   @db.Text
  algorithm String   @db.Text
  hash      String   @db.Text
  status    String   @db.Text
  result    Json?    @db.JsonB
  checkedAt DateTime @map("checked_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@id([tenantId, provider, hash], map: "file_reputation_cache_pkey")
  @@map("file_reputation_cache")
}

// Cada consulta que salió al servicio de reputación: contador compartido de la cuota del tenant.
model FileReputationQuotaUse {
  id       String   @id @db.Uuid
  tenantId String   @map("tenant_id") @db.Text
  provider String   @db.Text
  usedAt   DateTime @map("used_at") @db.Timestamptz(3)

  @@index([tenantId, provider, usedAt(sort: Desc)], map: "file_reputation_quota_uses_window_idx")
  @@map("file_reputation_quota_uses")
}

// Roles concedidos desde la administración; separados de las asignaciones del deploy y de los
// dueños del grupo. Reemplazo completo bajo compare-and-set sobre `revision`; sin DELETE.
model AccessRoleGrant {
  tenantId  String   @map("tenant_id") @db.Text
  oid       String   @db.Uuid
  roles     String[] @default([]) @db.Text
  revision  Int
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)
  updatedBy String   @map("updated_by") @db.Text

  @@id([tenantId, oid], map: "access_role_grants_pkey")
  @@map("access_role_grants")
}

// Solicitudes de cambio de rol con aprobación separada (Acceso y, para el rol privilegiado,
// Seguridad). Solo la aprobación final escribe `access_role_grants`, en la misma transacción que la
// solicitud y su AuditEvent. CAS sobre `revision`; sin DELETE. Las restricciones de distinción y de
// etapas viven en la migración; el índice único parcial (una abierta por objetivo y rol) también.
model AccessRoleRequest {
  tenantId                  String    @map("tenant_id") @db.Text
  id                        String    @db.Uuid
  targetOid                 String    @map("target_oid") @db.Uuid
  action                    String    @db.Text
  role                      String    @db.Text
  reason                    String    @db.Text
  ticket                    String?   @db.Text
  expectedGrantRevision     Int       @map("expected_grant_revision")
  requesterOid              String    @map("requester_oid") @db.Uuid
  requesterSubjectId        String    @map("requester_subject_id") @db.Text
  createdAt                 DateTime  @map("created_at") @db.Timestamptz(3)
  status                    String    @db.Text
  accessApproverOid         String?   @map("access_approver_oid") @db.Uuid
  accessApproverSubjectId   String?   @map("access_approver_subject_id") @db.Text
  accessApprovedAt          DateTime? @map("access_approved_at") @db.Timestamptz(3)
  accessReason              String?   @map("access_reason") @db.Text
  securityApproverOid       String?   @map("security_approver_oid") @db.Uuid
  securityApproverSubjectId String?   @map("security_approver_subject_id") @db.Text
  securityApprovedAt        DateTime? @map("security_approved_at") @db.Timestamptz(3)
  securityReason            String?   @map("security_reason") @db.Text
  closedByOid               String?   @map("closed_by_oid") @db.Uuid
  closedBy                  String?   @map("closed_by") @db.Text
  closedAt                  DateTime? @map("closed_at") @db.Timestamptz(3)
  closedReason              String?   @map("closed_reason") @db.Text
  revision                  Int
  updatedAt                 DateTime  @map("updated_at") @db.Timestamptz(3)

  @@id([tenantId, id], map: "access_role_requests_pkey")
  @@index([tenantId, status, createdAt(sort: Desc)], map: "access_role_requests_status_idx")
  @@map("access_role_requests")
}

