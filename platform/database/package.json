{
  "name": "@qapaq/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/src/index.js"
    },
    "./admission-contract": {
      "types": "./src/admission-contract.ts",
      "development": "./src/admission-contract.ts",
      "default": "./dist/src/admission-contract.js"
    },
    "./notification-stores": {
      "types": "./src/notification-stores.ts",
      "development": "./src/notification-stores.ts",
      "default": "./dist/src/notification-stores.js"
    },
    "./session-stores": {
      "types": "./src/session-stores.ts",
      "development": "./src/session-stores.ts",
      "default": "./dist/src/session-stores.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "validate": "prisma validate",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "migrate:dev": "prisma migrate dev",
    "test": "prisma generate && vitest run --config vitest.config.ts",
    "test:integration": "pnpm run test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@qapaq/configuration": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@aws-sdk/client-secrets-manager": "3.1138.0",
    "@types/pg": "8.23.1",
    "prisma": "7.10.0",
    "testcontainers": "12.1.0",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
