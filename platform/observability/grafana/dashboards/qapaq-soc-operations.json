{
  "uid": "qapaq-soc-operations",
  "title": "QAPAQ SecOps · Operación SOC",
  "tags": [
    "qapaq",
    "soc"
  ],
  "timezone": "utc",
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "title": "Alertas promovidas por prioridad.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "qapaq-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(qapaq_soc_alerts_total[5m])) by (priority)",
          "legendFormat": "{{priority}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Alertas sin cerrar por estado.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "qapaq-prometheus"
      },
      "targets": [
        {
          "expr": "sum(qapaq_soc_alerts_open) by (status, priority)",
          "legendFormat": "{{status}} · {{priority}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Tiempo entre la promoción de una alerta y su triaje.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "qapaq-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(qapaq_soc_triage_seconds_bucket[5m])) by (le, priority, verdict))",
          "legendFormat": "{{priority}} · {{verdict}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Incidentes abiertos por severidad.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "qapaq-prometheus"
      },
      "targets": [
        {
          "expr": "sum(qapaq_soc_incidents_open) by (severity)",
          "legendFormat": "{{severity}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Intentos de notificación crítica por canal y resultado.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "qapaq-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(qapaq_soar_notifications_total[5m])) by (channel, result, failure_class)",
          "legendFormat": "{{channel}} · {{result}} · {{failure_class}}"
        }
      ]
    }
  ]
}
