    <options>no_full_log</options>
    <mitre><id>T1562.008</id></mitre>
    <group>qapaq_aws_tamper,qapaq_defense_evasion,</group>
  </rule>

  <rule id="101616" level="6">
    <if_sid>101602</if_sid>
    <field name="aws.event_source" type="pcre2">^(events|sns)\.amazonaws\.com$</field>
