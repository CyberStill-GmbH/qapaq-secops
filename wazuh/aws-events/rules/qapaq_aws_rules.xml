<!--
  QAPAQ · AWS (cuenta 061098277310) vía EventBridge → SNS → wazuh/aws-events/receiver. IDs reservados: 101600-101699.
  Campos normalizados por el receptor (aws.event_name, aws.event_source, aws.user_type, aws.region, …).
  Región habitual: us-east-1 (los eventos de servicios globales — IAM, Organizations, sign-in — también llegan allí).
  Orden de las reglas hijas: Wazuh elige la PRIMERA hija que coincide; por eso root y región no habitual van primero.
-->
<group name="qapaq_provider,aws,">
  <rule id="101600" level="0">
    <decoded_as>json</decoded_as>
    <field name="qapaq.vendor">^aws$</field>
    <field name="qapaq.source">^eventbridge$</field>
    <description>QAPAQ AWS: evento de EventBridge.</description>
    <options>no_full_log</options>
  </rule>

  <rule id="101601" level="3">
    <if_sid>101600</if_sid>
    <field name="qapaq.event_type">^console_signin$</field>
    <description>QAPAQ AWS: $(aws.event_name) en consola de $(aws.principal) desde $(aws.source_ip).</description>
    <options>no_full_log</options>
    <group>qapaq_aws_signin,authentication,</group>
  </rule>

  <rule id="101602" level="3">
    <if_sid>101600</if_sid>
    <field name="qapaq.event_type">^cloudtrail_api$</field>
    <description>QAPAQ AWS: $(aws.event_name) ($(aws.event_source)) por $(aws.principal) en $(aws.region).</description>
    <options>no_full_log</options>
    <group>qapaq_aws_api,qapaq_audit,</group>
  </rule>

  <rule id="101603" level="3">
    <if_sid>101600</if_sid>
    <field name="qapaq.event_type">^other$</field>
    <description>QAPAQ AWS: evento $(aws.detail_type) de $(aws.source).</description>
    <options>no_full_log</options>
  </rule>

  <!-- ===================================================== consola / root -->
  <rule id="101605" level="13">
    <if_sid>101601</if_sid>
    <field name="aws.user_type">^Root$</field>
    <description>QAPAQ AWS: inicio de sesión de la cuenta ROOT ($(aws.event_name)) desde $(aws.source_ip).</description>
    <options>no_full_log</options>
    <mitre><id>T1078.004</id></mitre>
    <group>qapaq_aws_root,authentication_success,</group>
  </rule>

  <rule id="101607" level="5">
    <if_sid>101601</if_sid>
    <field name="aws.event_name">^ConsoleLogin$</field>
    <field name="aws.console_login">^Failure$</field>
    <description>QAPAQ AWS: inicio de sesión fallido en consola de $(aws.principal) desde $(aws.source_ip).</description>
    <options>no_full_log</options>
    <mitre><id>T1110</id></mitre>
    <group>authentication_failed,</group>
  </rule>

  <rule id="101608" level="10" frequency="5" timeframe="300">
    <if_matched_sid>101607</if_matched_sid>
    <same_field>aws.source_ip</same_field>
    <description>QAPAQ AWS: posible fuerza bruta en consola: 5+ inicios fallidos desde $(aws.source_ip) en 5 min.</description>
    <options>no_full_log</options>
    <mitre><id>T1110.001</id></mitre>
    <group>authentication_failures,qapaq_aws_bruteforce,</group>
  </rule>

  <rule id="101609" level="8">
    <if_sid>101601</if_sid>
    <field name="aws.event_name">^ConsoleLogin$</field>
    <field name="aws.console_login">^Success$</field>
    <field name="aws.user_type">^IAMUser$</field>
    <field name="aws.mfa_used">^No$</field>
    <description>QAPAQ AWS: usuario IAM $(aws.principal) entró a la consola SIN MFA desde $(aws.source_ip).</description>
    <options>no_full_log</options>
    <mitre><id>T1078.004</id></mitre>
    <group>authentication_success,qapaq_aws_no_mfa,</group>
  </rule>

  <rule id="101610" level="3">
    <if_sid>101601</if_sid>
    <field name="aws.event_name">^ConsoleLogin$</field>
    <field name="aws.console_login">^Success$</field>
    <description>QAPAQ AWS: inicio de sesión en consola de $(aws.principal) desde $(aws.source_ip).</description>
    <options>no_full_log</options>
    <group>authentication_success,</group>
  </rule>

  <!-- ===================================================== API: root y región no habitual -->
  <rule id="101606" level="12">
    <if_sid>101602</if_sid>
    <field name="aws.user_type">^Root$</field>
    <description>QAPAQ AWS: la cuenta ROOT ejecutó $(aws.event_name) ($(aws.event_source)) desde $(aws.source_ip).</description>
    <options>no_full_log</options>
    <mitre><id>T1078.004</id></mitre>
    <group>qapaq_aws_root,</group>
  </rule>

  <rule id="101611" level="10">
    <if_sid>101602</if_sid>
    <field name="aws.region" negate="yes">^us-east-1$</field>
    <description>QAPAQ AWS: actividad en región no habitual $(aws.region): $(aws.event_name) por $(aws.principal).</description>
    <options>no_full_log</options>
    <mitre><id>T1535</id></mitre>
    <group>qapaq_aws_unusual_region,</group>
  </rule>

  <rule id="101612" level="12">
