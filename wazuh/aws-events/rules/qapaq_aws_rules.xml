    <options>no_full_log</options>
    <mitre><id>T1535</id><id>T1496</id></mitre>
    <group>qapaq_aws_unusual_region,</group>
  </rule>

  <rule id="101613" level="4">
    <if_sid>101611</if_sid>
    <field name="aws.user_type">^AWSService$</field>
    <description>QAPAQ AWS: servicio AWS ($(aws.principal)) activo en región no habitual $(aws.region): $(aws.event_name).</description>
    <options>no_full_log</options>
  </rule>

  <!-- ===================================================== pipeline de monitoreo QAPAQ (antimanipulación) -->
