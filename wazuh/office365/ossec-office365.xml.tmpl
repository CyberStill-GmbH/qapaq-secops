<!-- QAPAQ:office365:begin — bloque administrado por wazuh/office365/apply-office365.sh; no editar a mano. -->
<office365>
  <enabled>yes</enabled>
  <!-- La Management Activity API publica contenido con minutos de demora; 1m no adelanta nada y 5m mantiene el consumo bajo. -->
  <interval>5m</interval>
  <curl_max_size>1M</curl_max_size>
  <!-- Solo eventos posteriores a la activación: la primera ejecución no reprocesa días de historia. -->
  <only_future_events>yes</only_future_events>
  <api_auth>
    <tenant_id>__TENANT_ID__</tenant_id>
    <client_id>__CLIENT_ID__</client_id>
    <!-- El secreto vive en un archivo 0640 root:wazuh, nunca en ossec.conf. -->
    <client_secret_path>/var/ossec/etc/office365/client_secret</client_secret_path>
    <api_type>__API_TYPE__</api_type>
  </api_auth>
  <subscriptions>
    <subscription>Audit.AzureActiveDirectory</subscription>
    <subscription>Audit.Exchange</subscription>
    <subscription>Audit.SharePoint</subscription>
    <subscription>Audit.General</subscription>
__DLP_SUBSCRIPTION__  </subscriptions>
</office365>
<!-- QAPAQ:office365:end -->
