{
  "policy": {
    "description": "QAPAQ hot(0-30d) -> warm(30-90d) -> cold(snapshot S3 y borrado local >90d). docs/05-datos-y-retencion.md",
    "default_state": "hot",
    "states": [
      {
        "name": "hot",
        "actions": [],
        "transitions": [{ "state_name": "warm", "conditions": { "min_index_age": "30d" } }]
      },
      {
        "name": "warm",
        "actions": [
          { "read_only": {} },
          { "replica_count": { "number_of_replicas": 0 } },
          { "force_merge": { "max_num_segments": 1 } }
        ],
        "transitions": [{ "state_name": "cold", "conditions": { "min_index_age": "90d" } }]
      },
      {
        "name": "cold",
        "actions": [
          {
            "retry": { "count": 3, "backoff": "exponential", "delay": "30m" },
            "snapshot": { "repository": "qapaq-s3", "snapshot": "{{ctx.index}}" }
          }
        ],
        "transitions": [{ "state_name": "deleted_local", "conditions": { "min_index_age": "91d" } }]
      },
      {
        "name": "deleted_local",
        "actions": [{ "delete": {} }],
        "transitions": []
      }
    ],
    "ism_template": [{ "index_patterns": ["wazuh-alerts-*", "wazuh-archives-*"], "priority": 100 }]
  }
}
