{
  "name": "qapaq-logins-per-user",
  "description": "QAPAQ: volumen anómalo de inicios de sesión (éxitos y fallos) por usuario en servidores Linux y consola AWS (docs/detection-engineering/07)",
  "time_field": "timestamp",
  "indices": ["wazuh-alerts-*"],
  "filter_query": {
    "bool": {
      "filter": [
        {
          "terms": {
            "rule.groups": ["authentication_success", "authentication_failed", "authentication_failures"]
          }
        },
        {
          "exists": {
            "field": "data.dstuser"
          }
        }
      ]
    }
  },
  "feature_attributes": [
    {
      "feature_name": "logins",
      "feature_enabled": true,
      "aggregation_query": {
        "logins": {
          "value_count": {
            "field": "rule.id"
          }
        }
      }
    }
  ],
  "detection_interval": {
    "period": {
      "interval": 10,
      "unit": "Minutes"
    }
  },
  "window_delay": {
    "period": {
      "interval": 5,
      "unit": "Minutes"
    }
  },
  "category_field": ["data.dstuser"]
}
