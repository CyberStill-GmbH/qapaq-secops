{
  "name": "qapaq-m365-login-failures",
  "description": "QAPAQ: ráfaga anómala de UserLoginFailed por usuario M365 (docs/07)",
  "time_field": "timestamp",
  "indices": ["wazuh-alerts-*"],
  "filter_query": {
    "bool": {
      "filter": [
        {
          "term": {
            "rule.groups": "office365"
          }
        },
        {
          "term": {
            "data.office365.Operation": "UserLoginFailed"
          }
        }
      ]
    }
  },
  "feature_attributes": [
    {
      "feature_name": "login_failures",
      "feature_enabled": true,
      "aggregation_query": {
        "login_failures": {
          "value_count": {
            "field": "rule.id"
          }
        }
      }
    }
  ],
  "detection_interval": {
    "period": {
      "interval": 10,
      "unit": "Minutes"
    }
  },
  "window_delay": {
    "period": {
      "interval": 5,
      "unit": "Minutes"
    }
  },
  "category_field": ["data.office365.UserId"]
}
