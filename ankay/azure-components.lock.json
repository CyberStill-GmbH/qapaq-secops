    "alpine3226": "docker.io/library/alpine:3.22.6@sha256:5291449c3df73caf6ed85e649dec1b9e818b39a5d8c871e97afc13e9cd5e8fa8",
    "node23": "docker.io/library/node:23@sha256:9a25b5a6f9a90218b73a62205f111e71de5e4289aee952b4dd7e86f7498f2544",
    "nginx1293": "docker.io/library/nginx:1.29.3@sha256:2f4e10193b0c4f61472245e9d26cea78e7df7af266c7e7cf5e67353ee2731b51",
    "python31316Alpine": "docker.io/library/python:3.13.16-alpine@sha256:2d9aefe2fef018a7eb2c13064c89c71929800fd2e5dccdbf52ea5da5bb8d929a"
  },
  "buildPolicy": {
    "amazonLinux2023Release": "2023.12.20261028"
  },
  "goSecurityUpgrades": {
    "minimumToolchain": "1.27.3",
    "golang.org/x/net": "v0.60.0",
    "golang.org/x/crypto": "v0.57.0",
    "golang.org/x/text": "v0.42.0",
    "golang.org/x/sys": "v0.48.0",
    "golang.org/x/term": "v0.46.0",
    "google.golang.org/grpc": "v1.83.2"
  },
  "componentStatus": {
    "frontend": "build-from-pinned-shuffle-source",
    "backend": "build-from-pinned-shuffle-and-shared-source-with-moby-v29-overlay",
    "worker": "build-from-pinned-shuffle-source-with-moby-v29-overlay",
    "opensearch": "pinned-opensearch-3.9.0-rebased-onto-deterministic-al2023",
    "orborus": "build-from-pinned-shuffle-v2.2.0-agpl-source-with-moby-v29-overlay",
    "docker-guard": "build-from-repository-source",
    "qapaq-ankay-app": "build-from-repository-source"
  },
  "securityBlockers": {
    "dockerSdk": {
      "module": "github.com/docker/docker@v28.3.3+incompatible",
      "status": "backend-worker-and-orborus-migrated-runtime-test-pending",
      "cves": ["CVE-2026-41567", "CVE-2026-42306"],
      "requiredEngineVersion": "29.5.1",
      "reason": "The backend, worker and Orborus use the official github.com/moby/moby/client and /api modules. The component set remains blocked from deployment until the Ankay runtime test against Engine 29.5.1 or later passes."
    },
    "mobyGoArchive": {
      "module": "github.com/moby/go-archive@v0.1.0",
      "status": "removed-from-backend-and-worker-module-graphs",
      "cves": ["CVE-2026-17106"],
      "fixedVersion": "v0.3.0",
      "reason": "Neither the backend nor worker module graph imports go-archive after migrating to Moby client/api. The nested shuffle-shared app_upload module remains excluded from the runtime build context and is not built into either image."
    }
  }
}
