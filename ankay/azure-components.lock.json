      "commit": "f81e48ec7dfdd9fd0b94c207fb6b58535ed52a90",
      "sum": "h1:Xb9EnYLyrhlP8AiH52Frst6iflIkbxyBmG/bntpRo5o=",
      "goModSum": "h1:0vOWNn+aXibNcbjROmrgszm3/KirYtwzE5BuVnCzQVE=",
      "license": "AGPL-3.0",
      "tlsContract": {
        "skipVerifyDefault": false,
        "certificateFileEnv": "SHUFFLE_OPENSEARCH_CERTIFICATE_FILE",
        "certificateDirectoryEnv": "SHUFFLE_CERT_DIR",
        "certificateDirectoryAppliedWhenEnvironmentIs": "not-cloud"
      }
    },
    "appSdk": {
      "repository": "https://github.com/Shuffle/app_sdk.git",
      "commit": "b504768b30cadc3681ed1e4c900d933f7dac5c42",
      "license": "MIT",
      "file": "shuffle_sdk/shuffle_sdk.py",
      "fileSha256": "f4a0820309df6e2768ffb233ef4848051b62515da0864fca279c6f903bc877a5"
    },
    "orborus": {
      "repository": "https://github.com/Shuffle/Shuffle.git",
      "tag": "v2.2.0",
      "commit": "36fad33c2e7afb47134d12dc23e6e99948e34b13",
      "path": "functions/onprem/orborus",
      "license": "AGPL-3.0",
      "status": "pinned",
      "overlay": "ankay/runtime/orborus/orborus-moby-v29.patch",
      "reason": "Last Shuffle monorepo tag that ships Orborus under the repository AGPL-3.0 LICENSE; the separate Shuffle/orborus repository has no license. Ported to the Moby v29 SDK with the shared moby-shuffle-shared overlay; compatibility with the v2.3.0 backend and worker still requires the Ankay runtime test."
    },
    "shuffleSecurity": {
      "repository": "https://github.com/Shuffle/shuffle-security.git",
      "commit": "7a4077c1353b3b7da93098acefb199d61894ebbf",
      "license": "NOASSERTION",
      "status": "excluded",
      "replacedBy": "dockerGuard",
      "reason": "No LICENSE file or SPDX metadata and not required to run Shuffle workflows; Ankay does not build or ship it. Its Compose slot is taken by the QAPAQ docker-guard."
    },
    "opensearch": {
      "repository": "docker.io/opensearchproject/opensearch",
      "tag": "3.9.0",
      "indexDigest": "sha256:adfa61f85025d06b4aeb562e7e74fde7e31c437039c93c3862c17e9acebd6c7c",
      "amd64Digest": "sha256:13487e0953520edf6cc866dfc672fd67a70ab122aa7d84d4a6c97106f84d3f84",
      "license": "Apache-2.0",
      "status": "pinned"
    },
    "dockerGuard": {
      "path": "ankay/runtime/docker-guard",
      "license": "MIT",
      "status": "built-from-repository-source",
      "reason": "QAPAQ-owned Docker API filtering proxy: the only container with the daemon socket. Orborus and workers reach it via DOCKER_HOST; it allowlists the non-swarm execution API surface, the reviewed images and Ankay-owned containers only."
    },
    "qapaqAnkayApp": {
      "path": "ankay/apps/qapaq-ankay/1.0.0",
      "license": "MIT",
      "sdkLicense": "MIT",
      "sdkLicenseSha256": "169637a174a1a62dba7566ef39002dbbc1f6a7d2a0009a858a699c7f03d4daa1",
      "status": "built-from-repository-source",
      "reason": "Single read-only Shuffle app used by the generated QAPAQ playbooks; replaces upstream python-apps images whose bases fail the HIGH/CRITICAL gate."
    }
  },
  "buildBases": {
    "amazonLinux2023": "public.ecr.aws/amazonlinux/amazonlinux:2023.12.20261021.0@sha256:d9b4c61f49de68d41e43af1c0ef89c5600b0ad51da024406a15f5d014720c998",
