@@ -0,0 +1,20 @@
+/* Ankay: centered login over the supplied rabbit fortress illustration. */
+.ankayLogin {
+  position: fixed;
+  inset: 0;
+  z-index: 1000;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  padding: 32px 24px;
+  overflow: auto;
+  background: linear-gradient(rgba(8, 8, 18, .2), rgba(8, 8, 18, .35)), url('/images/ankay-login.webp') center 52% / cover no-repeat;
+}
+.ankayLogin, .ankayLogin * { box-sizing: border-box; }
+.ankayLogin > div { width: min(440px, 100%); margin-block: auto; flex-shrink: 0; }
+.ankayLogin__mark { display: block; object-fit: contain; margin: 0 auto 16px; }
+.ankayLogin__title { margin: 0 0 28px; text-align: center; font-size: clamp(26px, 5vw, 32px); font-weight: 700; line-height: 1.2; letter-spacing: -.5px; }
+.ankayLogin input { min-width: 0; font-size: 16px; }
+@media (max-width: 600px) {
+  .ankayLogin { padding: 60px 16px 24px; background-image: linear-gradient(rgba(8, 8, 18, .22), rgba(8, 8, 18, .4)), url('/images/ankay-login-mobile.webp'); background-position: 50% center; }
+}
