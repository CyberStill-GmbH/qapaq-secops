{
  "id": "7941631a-343f-54dc-afd8-75ca4bb15d36",
  "name": "QAPAQ · Contención de identidad con aprobación (Entra)",
  "description": "Revoca sesiones y, si se aprueba, deshabilita la cuenta de Entra comprometida (cadenas 101700–101703, 101704, 101713). Doble compuerta: aprobación del Líder SOC (SoD) y qapaq_contencion_habilitada (false por defecto). Requiere aprobación de QAPAQ según docs/10 (A13, N5) y el permiso Graph User.RevokeSessions.All / User.EnableDisableAccount.All, que hoy no existe.",
  "start": "60042395-22ab-501f-869b-18e3fdf83e35",
  "actions": [
    {
      "id": "60042395-22ab-501f-869b-18e3fdf83e35",
      "label": "validar_solicitud",
      "name": "execute_python",
      "app_name": "Shuffle Tools",
      "app_version": "1.2.0",
      "app_id": "",
      "environment": "Shuffle",
      "is_valid": true,
      "isStartNode": true,
      "description": "Valida referencias opacas, solicitante y executionKey.",
      "authentication_id": "",
      "errors": [],
      "sharing": false,
      "private_id": "",
      "public": false,
      "parameters": [
        {
          "name": "code",
          "value": "import json\n# QAPAQ · valida la solicitud: referencias opacas, solicitante y clave de idempotencia (docs/14 §5).\nreq = json.loads(r\"\"\"$exec\"\"\") if isinstance(r\"\"\"$exec\"\"\", str) else $exec\nrequired = [\"incidentRef\", \"executionKey\", \"requestedBy\", \"targetRef\", \"actionId\"]\nmissing = [k for k in required if not req.get(k)]\nprint(json.dumps({\"valid\": \"false\" if missing else \"true\", \"missing\": missing, **{k: req.get(k, \"\") for k in required}}))\n",
          "required": false,
          "multiline": true,
          "id_": "",
          "variant": "STATIC_VALUE",
          "action_field": "",
          "example": "",
          "description": ""
        }
      ],
      "position": {
        "x": 200,
        "y": 0
      },
      "priority": 0,
      "execution_delay": 0
    },
    {
      "id": "a2ac538c-3d71-5da5-b8ed-b92d364223db",
      "label": "contexto_para_aprobar",
      "name": "execute_python",
      "app_name": "Shuffle Tools",
      "app_version": "1.2.0",
      "app_id": "",
      "environment": "Shuffle",
      "is_valid": true,
      "isStartNode": false,
      "description": "Prepara el texto de aprobación (sin datos personales).",
      "authentication_id": "",
      "errors": [],
      "sharing": false,
      "private_id": "",
      "public": false,
      "parameters": [
        {
          "name": "code",
          "value": "import json\n# QAPAQ · resumen para el aprobador: qué se pide, sobre qué referencia y con qué riesgo.\ns = $validar_solicitud.message\nprint(json.dumps({\"summary\": f\"Acción {s['actionId']} sobre {s['targetRef']} del incidente {s['incidentRef']}, pedida por {s['requestedBy']}.\",\n                  \"requestedBy\": s[\"requestedBy\"]}))\n",
          "required": false,
          "multiline": true,
          "id_": "",
          "variant": "STATIC_VALUE",
          "action_field": "",
          "example": "",
          "description": ""
        }
      ],
      "position": {
        "x": 400,
        "y": 0
      },
      "priority": 0,
      "execution_delay": 0
    },
    {
      "id": "2ae22102-bd4a-5c51-9d2e-4847f906088e",
      "label": "verificar_compuerta",
      "name": "execute_python",
      "app_name": "Shuffle Tools",
      "app_version": "1.2.0",
      "app_id": "",
      "environment": "Shuffle",
      "is_valid": true,
      "isStartNode": false,
      "description": "Compuerta: qapaq_contencion_habilitada = true y aprobador distinto del solicitante.",
      "authentication_id": "",
      "errors": [],
      "sharing": false,
      "private_id": "",
      "public": false,
      "parameters": [
        {
          "name": "code",
          "value": "import json\n# QAPAQ · compuerta doble: aprobación humana + habilitación registrada en docs/10. SoD: aprobador ≠ solicitante.\nenabled = \"$qapaq_contencion_habilitada\".strip().lower() == \"true\"\napprover = \"$aprobacion_lider_soc.approver\" if \"$aprobacion_lider_soc.approver\" != \"\" else \"\"\nrequester = $validar_solicitud.message[\"requestedBy\"]\nok = enabled and approver != \"\" and approver != requester\nprint(json.dumps({\"proceed\": \"true\" if ok else \"false\",\n                  \"reason\": \"ok\" if ok else (\"contención deshabilitada (docs/10)\" if not enabled else \"SoD: aprobador inválido o igual al solicitante\")}))\n",
          "required": false,
          "multiline": true,
          "id_": "",
          "variant": "STATIC_VALUE",
          "action_field": "",
          "example": "",
          "description": ""
        }
      ],
      "position": {
        "x": 800,
        "y": 0
      },
      "priority": 0,
      "execution_delay": 0
    },
