      "authentication_id": "",
      "errors": [],
      "sharing": false,
      "private_id": "",
      "public": false,
      "parameters": [
        {
          "name": "code",
          "value": "import json\n# QAPAQ · compuerta doble: aprobación humana + habilitación registrada en docs/10. SoD: aprobador ≠ solicitante.\nenabled = \"$qapaq_contencion_habilitada\".strip().lower() == \"true\"\napprover = \"$aprobacion_lider_soc.approver\" if \"$aprobacion_lider_soc.approver\" != \"\" else \"\"\nrequester = $validar_solicitud.message[\"requestedBy\"]\nok = enabled and approver != \"\" and approver != requester\nprint(json.dumps({\"proceed\": \"true\" if ok else \"false\",\n                  \"reason\": \"ok\" if ok else (\"contención deshabilitada (docs/10)\" if not enabled else \"SoD: aprobador inválido o igual al solicitante\")}))\n",
          "required": false,
          "multiline": true,
          "id_": "",
          "variant": "STATIC_VALUE",
          "action_field": "",
          "example": "",
          "description": ""
        }
      ],
