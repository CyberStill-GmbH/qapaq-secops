      "parameters": [
        {
          "name": "code",
          "value": "import json\n# QAPAQ · valida la solicitud: referencias opacas, solicitante y clave de idempotencia (docs/14 §5).\nreq = json.loads(r\"\"\"$exec\"\"\") if isinstance(r\"\"\"$exec\"\"\", str) else $exec\nrequired = [\"incidentRef\", \"executionKey\", \"requestedBy\", \"targetRef\", \"actionId\"]\nmissing = [k for k in required if not req.get(k)]\nprint(json.dumps({\"valid\": \"false\" if missing else \"true\", \"missing\": missing, **{k: req.get(k, \"\") for k in required}}))\n",
          "required": false,
          "multiline": true,
          "id_": "",
          "variant": "STATIC_VALUE",
          "action_field": "",
          "example": "",
          "description": ""
        }
      ],
