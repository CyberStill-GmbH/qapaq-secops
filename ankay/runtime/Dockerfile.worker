ARG GO_BUILDER_IMAGE
ARG ALPINE_RUNTIME_IMAGE
FROM ${GO_BUILDER_IMAGE} AS builder

WORKDIR /app
COPY functions/onprem/worker/go.mod functions/onprem/worker/go.sum ./
RUN go mod download

COPY functions/onprem/worker/worker.go ./
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -mod=readonly -o /app/worker .

FROM ${ALPINE_RUNTIME_IMAGE}
ENV SHUFFLE_BASE_IMAGE_REGISTRY=docker.io \
    SHUFFLE_BASE_IMAGE_NAME=frikky/shuffle \
    SHUFFLE_BASE_IMAGE_TAG_SUFFIX=0.8.70 \
    SHUFFLE_OPENSEARCH_URL=https://opensearch:9200 \
    SHUFFLE_CERT_DIR=/run/ankay/opensearch-ca
COPY --from=builder /app/worker /app/worker
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
WORKDIR /app
CMD ["./worker"]
