new file mode 100644
index 00000000..13288681
--- /dev/null
+++ b/backend/go-app/cloud_sync_url_test.go
@@ -0,0 +1,25 @@
+package main
+
+import "testing"
+
+func TestNormalizeCloudSyncBaseURL(t *testing.T) {
+	tests := []struct {
+		name  string
+		input string
+		want  string
+	}{
+		{name: "canonical upstream", input: "https://shuffler.io", want: "https://shuffler.io"},
+		{name: "local development", input: "http://localhost:5002", want: "http://localhost:5002"},
+		{name: "region endpoint is normalized", input: "https://eu.shuffler.io", want: "https://shuffler.io"},
+		{name: "arbitrary host is normalized", input: "https://example.invalid", want: "https://shuffler.io"},
+		{name: "empty endpoint is normalized", input: "", want: "https://shuffler.io"},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := normalizeCloudSyncBaseURL(tt.input); got != tt.want {
+				t.Fatalf("normalizeCloudSyncBaseURL(%q) = %q, want %q", tt.input, got, tt.want)
+			}
+		})
+	}
+}
