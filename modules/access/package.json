{
  "name": "@qapaq/access",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./postgres": {
      "types": "./src/infrastructure/postgres-session-store.ts",
      "development": "./src/infrastructure/postgres-session-store.ts",
      "default": "./dist/infrastructure/postgres-session-store.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --dir ../.. exec vitest run --config vitest.config.ts modules/access/test"
  },
  "dependencies": {
    "@qapaq/audit": "workspace:*",
    "@qapaq/contracts": "workspace:*",
    "@qapaq/database": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "pg": "8.23.0",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
