{
  "name": "@qapaq/telemetry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./wazuh": {
      "types": "./src/wazuh-normalization.ts",
      "development": "./src/wazuh-normalization.ts",
      "default": "./dist/wazuh-normalization.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --dir ../.. exec vitest run --config vitest.config.ts modules/telemetry/test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1138.0",
    "@qapaq/contracts": "workspace:*",
    "@qapaq/database": "workspace:*"
  },
  "devDependencies": {
    "@qapaq/testing": "workspace:*",
    "@types/node": "24.13.6",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
