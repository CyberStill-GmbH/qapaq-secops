{
  "name": "@qapaq/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-schema.mjs",
    "generate:security-event": "node scripts/generate-security-event-types.mjs",
    "test:contract": "vitest run --root ../.. packages/contracts/test/security-event.contract.spec.ts --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "json-schema-to-typescript": "16.0.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
