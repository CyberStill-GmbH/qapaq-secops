# API QAPAQ en el nodo PowerUser. Los valores sensibles están en /opt/qapaq/secrets/api.env (0600).
# Identidad: Entra real del tenant QAPAQ (login OIDC) JUNTO a las cuentas demo de contraseña, por el
# opt-in explícito QAPAQ_DEMO_LOGIN_WITH_ENTRA=true (docs/04-identidad-y-acceso.md). Sin el opt-in,
# production solo admite las cuentas demo con la identidad fija DEMO_DEPLOYMENT_IDENTITY, y
# QAPAQ_DEMO_ACCOUNTS en secrets/api.env con la excepción apagada impide arrancar el API.
NODE_ENV=production
QAPAQ_PROFILE=production
QAPAQ_API_HOST=0.0.0.0
QAPAQ_API_PORT=3000
QAPAQ_ACCESS_IDENTITY_MODE=entra
QAPAQ_ENTRA_TENANT_ID=45f2f938-dbe3-4a3e-8a54-930893f94ef8
QAPAQ_ENTRA_CLIENT_ID=336d44fe-b99d-4cfd-9c6e-0ed2d7e48998
QAPAQ_ENTRA_AUTHORITY=https://login.microsoftonline.com
QAPAQ_ENTRA_REDIRECT_URI=https://${SOC_HOSTNAME}/api/auth/callback
QAPAQ_ENTRA_ALLOWED_REDIRECT_URIS=https://${SOC_HOSTNAME}/api/auth/callback
QAPAQ_ENTRA_CLIENT_SECRET_REF=secret://qapaq-soc-dev/entra/client-secret
QAPAQ_CONSOLE_BASE_URL=https://${SOC_HOSTNAME}
QAPAQ_ACCESS_ALLOWED_CIDRS=0.0.0.0/0,::/0
QAPAQ_ACCESS_TRUSTED_PROXY_CIDRS=172.30.89.11/32
QAPAQ_SOC_PERSISTENCE=postgres
QAPAQ_POSTGRES_HOST=postgres
QAPAQ_POSTGRES_PORT=5432
QAPAQ_POSTGRES_DATABASE=qapaq_secops
QAPAQ_POSTGRES_USERNAME=qapaq_soc_runtime
QAPAQ_POSTGRES_TLS=true
# Ingesta Wazuh sin Entra: gateway con token estático (scripts/setup-ingestion.sh). El token
# está en /opt/qapaq/secrets/api.env (QAPAQ_WAZUH_GATEWAY_ACCESS_TOKEN).
QAPAQ_INGESTION_SOURCE=wazuh
QAPAQ_WAZUH_GATEWAY_AUTH=static-token
QAPAQ_WAZUH_GATEWAY_BASE_URL=https://wazuh-gateway:8443
QAPAQ_INGESTION_INTERVAL=60s
QAPAQ_INGESTION_INITIAL_LOOKBACK_MINUTES=60
QAPAQ_DEMO_ADMIN_LOGIN_ENABLED=true
QAPAQ_DEMO_LOGIN_WITH_ENTRA=true
QAPAQ_DEMO_ADMIN_LOGIN_UNTIL=${DEMO_UNTIL}
QAPAQ_DEMO_ADMIN_USERNAME=admin@qapaq.pe
# Padrón del grupo de admisión por Microsoft Graph (miembros, dueños y solicitudes de rol en
# «Usuarios y sesiones»). Requiere consentimiento de administrador para el permiso de aplicación
# GroupMember.Read.All (mínimo) o Group.Read.All. El cliente usa el token app-only de
# QAPAQ_ENTRA_CLIENT_SECRET y scope graph.microsoft.com/.default. Sin permiso o si el grupo por nombre
# no se puede resolver, el API arranca igual y muestra el estado pendiente; reintenta sin reinicio.
QAPAQ_DIRECTORY_SYNC=graph
QAPAQ_DIRECTORY_GROUP_ID=bbf1d58b-19e6-4261-b196-5ebcd8176d85
# Correlador privado (services/qapaq-correlator): lectura para /api/risk/*. Los tokens de lectura
# y de servicio están en /opt/qapaq/secrets/api.env (bootstrap-correlator.sh).
QAPAQ_CORRELATOR_URL=http://correlator:8080
# Informes de Qapaqzito (services/qapaq-reports, red interna). El token QAPAQ_REPORTS_TOKEN está en
# /opt/qapaq/secrets/api.env (scripts/bootstrap-reports.sh); sin él el API no arranca con la URL.
QAPAQ_REPORTS_URL=http://reports:8090
# Teams solo recibe lo que requiere atención (P1/P2 frescas e incidentes, y el resumen de
# P1/P2 agrupadas o atrasadas). El resumen periódico P3/P4 queda apagado: se revisa en la cola.
QAPAQ_NOTIFY_DIGEST_MINUTES=0
# Inicialización de canales de aviso (docs/18 §Inicialización de canales). Las entradas vienen de
# /opt/qapaq/secrets/services.env y deploy-host.sh las copia a /opt/qapaq/secrets/api.env en cada
# despliegue; no se escriben aquí:
#   QAPAQ_TEAMS_WORKFLOW_URL  webhook del Workflow de Teams (credencial).
#   QAPAQ_ALERT_MAIL_SENDER   buzón remitente del respaldo por correo (UPN; requiere Mail.Send).
# En el primer arranque el API crea la fila de cada canal (`system:bootstrap`): configurado ⇒
# activo; sin configurar ⇒ visible en Notificaciones → Canales como pendiente. Después manda la
# base: un cambio hecho en la consola no se pisa al redesplegar.
# Analista IA (docs/27 «Implementación 2026-11-14»). deploy-host.sh añade QAPAQ_ANALYST_ENABLED=true
# (y un techo de 2 USD si hay clave de Claude) salvo que secrets/services.env diga otra cosa. Reutiliza el proveedor y
# la clave de Qapaqzito (QAPAQ_QAPAQZITO_PROVIDER / QAPAQ_QAPAQZITO_API_KEY en services.env): no hay secretos nuevos.
# Sin techo diario no hay inferencia (todo determinista). Rollback: QAPAQ_ANALYST_ENABLED=false.
# QAPAQ_ANALYST_ENABLED=false
# QAPAQ_ANALYST_DAILY_CEILING_USD=2
# QAPAQ_ANALYST_ECONOMY_MODEL=claude-haiku-5-5
# QAPAQ_ANALYST_ADVANCED_MODEL=claude-sonnet-5-5
# QAPAQ_ANALYST_CONCURRENCY=1
# QAPAQ_ANALYST_BACKLOG_SWEEP=true
