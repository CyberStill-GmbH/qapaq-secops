# Edge QAPAQ del nodo PowerUser (nginx en contenedor). Copia de wazuh/edge/qapaq-edge.conf adaptada
# a Docker: upstreams por nombre de servicio y Ankay en /ankay/. La única forma de
# entrar es la sesión QAPAQ (login del plugin qapaq_ops); el dashboard confía en x-proxy-user /
# x-proxy-roles solo porque los fija este edge tras /api/auth/introspect.
# Mantener sincronizado con wazuh/edge/qapaq-edge.conf (rutas, allowlist y cabeceras).
# Variables (envsubst en deploy-host.sh): ${SOC_HOSTNAME}

resolver 127.0.0.11 valid=30s ipv6=off;

# IP real del cliente detrás del ALB (subredes de la VPC del stack).
set_real_ip_from 10.89.0.0/24;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

proxy_cache_path /var/cache/nginx/qapaq_auth levels=1 keys_zone=qapaq_auth:10m max_size=50m inactive=60s;

# Webhook SNS (monitoreo de la cuenta AWS, wazuh/aws-events): límite por IP de origen de SNS.
limit_req_zone $binary_remote_addr zone=qapaq_aws_sns:1m rate=50r/s;
limit_req_zone $binary_remote_addr zone=qapaq_wazuh_push:1m rate=200r/s;

upstream qapaq_api {
  server api:3000;
  keepalive 16;
}

upstream qapaq_osd {
  server wazuh.dashboard:5601;
  keepalive 16;
}

# Ankay SSO (decisión B11): token compartido edge → puente, en un archivo secreto que deja
# ankay/sso/bootstrap.mjs. Sin archivo, el token queda vacío y el puente rechaza todo (403):
# el SSO falla cerrado.
map $host $ankay_sso_token {
  default "";
  include /etc/nginx/ankay-sso/edge-token.map*;
}

map $http_accept $qapaq_wants_html {
  default 0;
  "~*text/html" 1;
}

server {
  listen 80;
  server_name ${SOC_HOSTNAME};
  server_tokens off;
  location /.well-known/acme-challenge/ { root /var/www/certbot; }
  location / { return 301 https://$host$request_uri; }
}

server {
  listen 443 ssl default_server;
  http2 on;
  server_name ${SOC_HOSTNAME};
  ssl_certificate     /etc/letsencrypt/live/${SOC_HOSTNAME}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${SOC_HOSTNAME}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  server_tokens off;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;

  client_max_body_size 50m;
  proxy_http_version 1.1;
  proxy_set_header Connection "";

  # Health check del ALB (y smoke): solo el liveness del API.
  location = /health/live {
    proxy_pass http://qapaq_api;
  }

  # QAPAQ:aws-sns:begin — EventBridge → SNS → este webhook → receptor aws-events (wazuh/aws-events).
  # Sin sesión QAPAQ: la autenticidad la da la firma SNS (v2/SHA256) y la lista de TopicArn que
  # verifica el receptor. Solo POST, cuerpo acotado (SNS ≤ 256 KB) y límite de tasa (503 → SNS reintenta).
  location = /hooks/aws-sns {
    limit_except POST { deny all; }
    limit_req zone=qapaq_aws_sns burst=200 nodelay;
    limit_req_status 503;
    client_max_body_size 300k;
    client_body_buffer_size 300k;
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $qapaq_aws_events http://aws-events:8080;
    proxy_pass $qapaq_aws_events;
    proxy_set_header Host aws-events;
    proxy_set_header Connection "";
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Cookie "";
    proxy_set_header Authorization "";
    proxy_set_header x-proxy-user "";
    proxy_set_header x-proxy-roles "";
    proxy_connect_timeout 3s;
    proxy_read_timeout 20s;
  }
  # QAPAQ:aws-sns:end

  # Wazuh Manager -> durable QAPAQ inbox. This route is intentionally public at the edge but
  # authenticated by the endpoint's timestamped HMAC; it must not require a browser session.
  # Keep the body minimal and do not forward browser/session identity headers.
  location = /api/ingest/wazuh {
    limit_except POST { deny all; }
    limit_req zone=qapaq_wazuh_push burst=400 nodelay;
    limit_req_status 429;
    client_max_body_size 64k;
    client_body_buffer_size 64k;
    proxy_pass http://qapaq_api;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Cookie "";
    proxy_set_header Authorization "";
    proxy_set_header x-proxy-user "";
    proxy_set_header x-proxy-roles "";
    proxy_buffering off;
    proxy_connect_timeout 2s;
    proxy_read_timeout 5s;
  }

  # Inicio y cierre de sesión QAPAQ: además de proxyear al API, borran la sesión de Ankay
  # (cookies de Shuffle acotadas a /ankay). Así una sesión de Shuffle nunca sobrevive a un
  # cambio de persona en el navegador. En el logout, un mirror avisa al puente para que cierre
  # también la sesión en Shuffle (best effort: si el puente no está, el logout de QAPAQ no cambia).
  location ~ ^/api/auth/(callback|password|logout)$ {
    # No registrar URLs de autenticación: callbacks antiguos pueden traer code/state en query.
    access_log off;
    mirror /_qapaq/respond-sso-logout;
    mirror_request_body off;
    proxy_pass http://qapaq_api;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Sec-Fetch-Site $http_sec_fetch_site;
    proxy_set_header x-proxy-user "";
    proxy_set_header x-proxy-roles "";
    proxy_buffering off;
    proxy_read_timeout 65s;
    add_header Set-Cookie "session_token=; Path=/ankay; Max-Age=0; Secure; HttpOnly; SameSite=Strict" always;
    add_header Set-Cookie "__session=; Path=/ankay; Max-Age=0; Secure; HttpOnly; SameSite=Strict" always;
    add_header Set-Cookie "ankay_logout=; Path=/api/auth/logout; Max-Age=0; Secure; HttpOnly; SameSite=Strict" always;
    # Restos con Path=/ de versiones anteriores del frontend de Shuffle (cookie legible por JS).
    add_header Set-Cookie "session_token=; Path=/; Max-Age=0; Secure; SameSite=Strict" always;
    add_header Set-Cookie "__session=; Path=/; Max-Age=0; Secure; SameSite=Strict" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  }

  location = /_qapaq/respond-sso-logout {
    internal;
    # Solo el POST de /api/auth/logout llega al puente; callback y password no.
    if ($request_uri != /api/auth/logout) {
      return 204;
    }
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $ankay_sso http://ankay-sso:8080;
    proxy_pass $ankay_sso/logout;
    proxy_method POST;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Host ankay-sso;
    proxy_set_header Cookie $http_cookie;
    proxy_set_header X-Qapaq-Edge-Token $ankay_sso_token;
    proxy_connect_timeout 2s;
    proxy_read_timeout 5s;
  }

  # Informes de Qapaqzito: listado y descarga de los archivos propios (solo GET). La API exige sesión
  # y responde 404 neutro a quien no es el dueño; aquí solo se admiten estas dos rutas exactas.
  location ~ "^/api/assistant/artifacts(/[0-9a-fA-F-]{36})?$" {
    limit_except GET { deny all; }
    proxy_pass http://qapaq_api;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Sec-Fetch-Site $http_sec_fetch_site;
    proxy_set_header x-proxy-user "";
    proxy_set_header x-proxy-roles "";
    proxy_buffering off;
    proxy_read_timeout 65s;
  }

  # Chat de Qapaqzito: un turno con `generate_report` puede tardar más que el resto de la API (render
  # de PDF hasta 90 s en el servicio de informes). Sin buffer para que el SSE llegue en vivo.
  location ~ ^/api/assistant/chat(/stream)?$ {
    proxy_pass http://qapaq_api;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Sec-Fetch-Site $http_sec_fetch_site;
    proxy_set_header x-proxy-user "";
    proxy_set_header x-proxy-roles "";
    proxy_buffering off;
    proxy_read_timeout 180s;
  }

  location ~ ^/api/(auth|alerts|incidents|ai-investigations|changes|sources|operations|audit|admin|me|assistant|risk)(/|$) {
    proxy_pass http://qapaq_api;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Sec-Fetch-Site $http_sec_fetch_site;
    proxy_set_header x-proxy-user "";
    proxy_set_header x-proxy-roles "";
    proxy_buffering off;
    proxy_read_timeout 65s;
  }

  location ~ "^/api/notifications(/[0-9a-fA-F-]{36}(/acknowledge)?|/supersede-stale|/channels(/teams|/(teams|email|push)/(test|enable|disable))?)?$" {
    proxy_pass http://qapaq_api;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Sec-Fetch-Site $http_sec_fetch_site;
    proxy_set_header x-proxy-user "";
    proxy_set_header x-proxy-roles "";
  }

  location = /_qapaq/introspect {
    internal;
    proxy_pass http://qapaq_api/api/auth/introspect;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Host $host;
    proxy_set_header Cookie $http_cookie;
    proxy_set_header Accept "application/json";
    proxy_set_header Origin https://$host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header x-proxy-user "";
    proxy_set_header x-proxy-roles "";
    proxy_cache          qapaq_auth;
    proxy_cache_key      $cookie_qapaq_session;
    proxy_cache_valid    204 5s;
    proxy_cache_valid    401 403 0;
    proxy_ignore_headers Cache-Control Expires Set-Cookie;
  }

  location ^~ /qapaq/ {
    # El login de qapaq_ops fija su propia Referrer-Policy (same-origin) y X-Content-Type-Options:
    # un add_header aquí evita heredar los del server (duplicados y en conflicto). Solo HSTS.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    proxy_pass http://qapaq_osd;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header x-proxy-user "";
    proxy_set_header x-proxy-roles "";
  }

  location ^~ /ui/ {
    proxy_pass http://qapaq_osd;
    proxy_set_header Host $host;
    proxy_set_header x-proxy-user "";
    proxy_set_header x-proxy-roles "";
  }

  location = /app/login {
    return 302 /qapaq/login$is_args$args;
  }

  # Ankay (Shuffle rebrandeado), solo con sesión QAPAQ (wazuh/edge/qapaq-ankay.location.conf).
  location = /ankay {
    return 308 /ankay/;
  }

  # SSO QAPAQ → Ankay (decisión B11): con sesión QAPAQ, el puente abre la sesión de Shuffle de
  # esa persona y vuelve a `next`. El login propio de Shuffle no se muestra: se redirige aquí.
  # Ubicaciones exactas: `^~ /ankay/` corta la búsqueda de regex, `=` gana siempre.
  location = /ankay/login      { return 302 /ankay/sso; }
  location = /ankay/login2     { return 302 /ankay/sso; }
  location = /ankay/loginsetup { return 302 /ankay/sso; }
  location = /ankay/login_sso  { return 302 /ankay/sso; }

  location = /ankay/sso {
    auth_request /_qapaq/introspect;
    auth_request_set $qapaq_user  $upstream_http_x_qapaq_user;
    auth_request_set $qapaq_roles $upstream_http_x_qapaq_roles;
    error_page 401 = @qapaq_sign_in;
    error_page 403 = @qapaq_forbidden;

    resolver 127.0.0.11 valid=30s ipv6=off;
    set $ankay_sso http://ankay-sso:8080;
    proxy_pass $ankay_sso/sso$is_args$args;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Host ankay-sso;
    # Identidad SOLO desde el introspect: pisa cualquier x-qapaq-* que mande el navegador.
    proxy_set_header x-qapaq-user  $qapaq_user;
    proxy_set_header x-qapaq-roles $qapaq_roles;
    proxy_set_header X-Qapaq-Edge-Token $ankay_sso_token;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Cookie "";
    proxy_set_header x-proxy-user "";
    proxy_set_header x-proxy-roles "";
    proxy_read_timeout 30s;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
  }

  location ^~ /ankay/ {
    auth_request /_qapaq/introspect;
    error_page 401 = @qapaq_sign_in;
    error_page 403 = @qapaq_forbidden;

    set $ankay http://ankay-qapaq-frontend:80;
    rewrite ^/ankay/(.*)$ /$1 break;
    proxy_pass $ankay;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Prefix /ankay;
    # Las cookies de sesión que emita Shuffle (Path=/) quedan acotadas a /ankay, HttpOnly,
    # Secure y SameSite=Strict, igual que las del puente SSO.
    proxy_cookie_path ~^/$ /ankay;
    proxy_cookie_flags ~ secure httponly samesite=strict;
    proxy_set_header x-proxy-user "";
    proxy_set_header x-proxy-roles "";
    proxy_read_timeout 300s;
    proxy_buffering off;
    proxy_set_header Accept-Encoding "";
    sub_filter 'href="/' 'href="/ankay/';
    sub_filter 'src="/' 'src="/ankay/';
    sub_filter 'href:"/' 'href:"/ankay/';
    sub_filter '/static/' '/ankay/static/';
    sub_filter '/images/' '/ankay/images/';
    sub_filter_types text/html text/css application/javascript application/json;
    sub_filter_once off;

    # Embebido en el SIEM (app «Ankay» de qapaq_ops, iframe del mismo origen): se reemplazan
    # X-Frame-Options DENY y frame-ancestors 'none' de Shuffle por SAMEORIGIN / 'self'. El resto
    # de la CSP es la de ankay (patch 0003). add_header en un location anula los del
    # server, por eso se repiten.
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Content-Security-Policy;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:; font-src 'self' data:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  }

  location / {
    auth_request /_qapaq/introspect;
    auth_request_set $qapaq_user  $upstream_http_x_qapaq_user;
    auth_request_set $qapaq_roles $upstream_http_x_qapaq_roles;
    error_page 401 = @qapaq_sign_in;
    error_page 403 = @qapaq_forbidden;

    proxy_pass http://qapaq_osd;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header x-proxy-user  $qapaq_user;
    proxy_set_header x-proxy-roles $qapaq_roles;
    proxy_read_timeout 120s;
  }

  location @qapaq_sign_in {
    if ($qapaq_wants_html) {
      return 302 /qapaq/login?nextUrl=$request_uri;
    }
    default_type application/json;
    return 401 '{"code":"AUTH_REQUIRED"}';
  }

  location @qapaq_forbidden {
    if ($qapaq_wants_html) {
      return 302 /qapaq/login?authError=NETWORK_NOT_ALLOWED;
    }
    default_type application/json;
    return 403 '{"code":"NETWORK_NOT_ALLOWED"}';
  }
}
