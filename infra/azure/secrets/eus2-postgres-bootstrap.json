{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "vaultName": {
      "type": "string",
      "allowedValues": ["kv-qapaqsecopsd-3a2405f3"]
    },
    "vmName": {
      "type": "string",
      "allowedValues": ["vm-qapaqsecopsdemoeus-siem"]
    },
    "location": {
      "type": "string",
      "allowedValues": ["eastus2"]
    },
    "runCommandName": {
      "type": "string",
      "minLength": 20,
      "maxLength": 80
    },
    "script": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32000
    },
    "masterUsername": {
      "type": "string",
      "allowedValues": ["qapaqbootstrap"]
    },
    "masterPassword": {
      "type": "secureString"
    },
    "runtimePassword": {
      "type": "secureString"
    },
    "createEntityRefKey": {
      "type": "bool",
      "defaultValue": false
    },
    "entityRefKey": {
      "type": "secureString",
      "defaultValue": ""
    }
  },
  "resources": [
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2025-05-01",
      "name": "[format('{0}/{1}', parameters('vaultName'), 'qapaq-postgres-app-password')]",
      "properties": {
        "value": "[parameters('runtimePassword')]",
        "attributes": {
          "enabled": true
        },
        "contentType": "application/vnd.qapaq.postgres-runtime-password"
      }
    },
    {
      "condition": "[parameters('createEntityRefKey')]",
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2025-05-01",
      "name": "[format('{0}/{1}', parameters('vaultName'), 'qapaq-entity-ref-key')]",
      "properties": {
        "value": "[parameters('entityRefKey')]",
        "attributes": {
          "enabled": true
        },
        "contentType": "application/vnd.qapaq.secops-secret"
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines/runCommands",
      "apiVersion": "2024-07-01",
      "name": "[format('{0}/{1}', parameters('vmName'), parameters('runCommandName'))]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults/secrets', parameters('vaultName'), 'qapaq-postgres-app-password')]"
      ],
      "properties": {
        "source": {
          "script": "[parameters('script')]"
        },
        "protectedParameters": [
          {
            "name": "QAPAQ_MASTER_USERNAME",
            "value": "[parameters('masterUsername')]"
          },
          {
            "name": "QAPAQ_MASTER_PASSWORD",
            "value": "[parameters('masterPassword')]"
          },
          {
            "name": "QAPAQ_RUNTIME_PASSWORD",
            "value": "[parameters('runtimePassword')]"
          }
        ],
        "asyncExecution": false,
        "timeoutInSeconds": 1200,
        "treatFailureAsDeploymentFailure": true
      }
    }
  ]
}
