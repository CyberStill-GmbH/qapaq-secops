{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "secretValue": {
      "type": "secureString",
      "metadata": {
        "description": "QAPAQ API Entra client secret sourced from the repository secret ENTRA_CLIENT_SECRET."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2025-05-01",
      "name": "kv-qapaqsecopsd-66f8c73b/qapaq-entra-client-secret",
      "properties": {
        "value": "[parameters('secretValue')]",
        "attributes": {
          "enabled": true
        },
        "contentType": "application/vnd.qapaq.entra-client-secret"
      }
    }
  ]
}
