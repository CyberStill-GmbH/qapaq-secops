#cloud-config
write_files:
  - path: /etc/ankay/compose.yaml
    owner: root:root
    permissions: '0600'
    encoding: b64
    content: ${compose_b64}
  - path: /etc/ankay/compose.sha256
    owner: root:root
    permissions: '0600'
    content: ${compose_sha}
  - path: /usr/local/sbin/ankay-prepare-data-disk
    owner: root:root
    permissions: '0750'
    encoding: b64
    content: ${disk_bootstrap_b64}
runcmd:
  - [python3, /usr/local/sbin/ankay-prepare-data-disk, "${data_disk_gb}"]
