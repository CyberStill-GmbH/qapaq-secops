# QAPAQ SecOps · refresco diario de las listas de reputación de IP en Wazuh (docs/18).
# Instalar: install -m 0644 este archivo y el .timer en /etc/systemd/system; systemctl enable --now qapaq-threat-intel.timer
[Unit]
Description=QAPAQ SecOps: listas CDB de reputacion de IP (Spamhaus DROP, abuse.ch Feodo, Tor, Cloudflare WAF)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/bash /opt/qapaq/src/infra/wazuh/network/deploy-network.sh lists
Nice=10
TimeoutStartSec=900
